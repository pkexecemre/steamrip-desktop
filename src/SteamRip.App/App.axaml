<Application
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:Class="SteamRip.App.App"
    RequestedThemeVariant="Dark"
>
    <Application.Resources>
        <!-- Palette: cold ink, one amber accent, no glow. Colours carry state, not decoration. -->
        <Color x:Key="InkColor">#0C0F14</Color>
        <Color x:Key="PanelColor">#11151B</Color>
        <Color x:Key="RaisedColor">#181D25</Color>
        <Color x:Key="LineColor">#242B35</Color>
        <Color x:Key="TextColor">#E8EBF0</Color>
        <Color x:Key="MutedColor">#8D97A6</Color>
        <Color x:Key="AmberColor">#F2B544</Color>
        <Color x:Key="GreenColor">#62C08D</Color>
        <Color x:Key="RedColor">#E2685D</Color>

        <SolidColorBrush x:Key="Ink" Color="{StaticResource InkColor}" />
        <SolidColorBrush x:Key="Panel" Color="{StaticResource PanelColor}" />
        <SolidColorBrush x:Key="Raised" Color="{StaticResource RaisedColor}" />
        <SolidColorBrush x:Key="Line" Color="{StaticResource LineColor}" />
        <SolidColorBrush x:Key="Text" Color="{StaticResource TextColor}" />
        <SolidColorBrush x:Key="Muted" Color="{StaticResource MutedColor}" />
        <SolidColorBrush x:Key="Amber" Color="{StaticResource AmberColor}" />
        <SolidColorBrush x:Key="Green" Color="{StaticResource GreenColor}" />
        <SolidColorBrush x:Key="Red" Color="{StaticResource RedColor}" />
        <!-- Popups (menus, flyouts, combo dropdowns) inherit Fluent's grey otherwise. Same ink/panel/line as the cards. -->
        <SolidColorBrush
            x:Key="MenuFlyoutPresenterBackground"
            Color="{StaticResource PanelColor}"
        />
        <SolidColorBrush
            x:Key="MenuFlyoutPresenterBorderBrush"
            Color="{StaticResource LineColor}"
        />
        <!-- Fluent's controls default to a blue accent; the app has exactly one accent. -->
        <SolidColorBrush x:Key="ToggleSwitchFillOn" Color="{StaticResource AmberColor}" />
        <SolidColorBrush x:Key="ToggleSwitchFillOnPointerOver" Color="#FFC866" />
        <SolidColorBrush x:Key="ToggleSwitchFillOnPressed" Color="#D9A23A" />
        <SolidColorBrush x:Key="ToggleSwitchStrokeOn" Color="{StaticResource AmberColor}" />
        <SolidColorBrush x:Key="ToggleSwitchStrokeOnPointerOver" Color="#FFC866" />
        <SolidColorBrush x:Key="ToggleSwitchStrokeOnPressed" Color="#D9A23A" />
        <SolidColorBrush x:Key="ToggleSwitchKnobFillOn" Color="{StaticResource InkColor}" />
        <SolidColorBrush x:Key="ToggleSwitchKnobFillOff" Color="{StaticResource MutedColor}" />
        <SolidColorBrush
            x:Key="CheckBoxCheckBackgroundFillChecked"
            Color="{StaticResource AmberColor}"
        />
        <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillCheckedPointerOver" Color="#FFC866" />
        <SolidColorBrush
            x:Key="CheckBoxCheckBackgroundStrokeChecked"
            Color="{StaticResource AmberColor}"
        />
        <SolidColorBrush
            x:Key="CheckBoxCheckGlyphForegroundChecked"
            Color="{StaticResource InkColor}"
        />
        <SolidColorBrush x:Key="NumericUpDownBackground" Color="{StaticResource PanelColor}" />
        <SolidColorBrush x:Key="NumericUpDownBorderBrush" Color="{StaticResource LineColor}" />
        <SolidColorBrush
            x:Key="NumericUpDownButtonBackground"
            Color="{StaticResource RaisedColor}"
        />
        <SolidColorBrush x:Key="ProgressBarForeground" Color="{StaticResource AmberColor}" />
        <SolidColorBrush x:Key="ProgressBarBackground" Color="{StaticResource RaisedColor}" />
        <SolidColorBrush x:Key="SliderTrackValueFill" Color="{StaticResource AmberColor}" />
        <SolidColorBrush
            x:Key="SystemControlHighlightAccentBrush"
            Color="{StaticResource AmberColor}"
        />
        <!-- The presenter template reads these two, not Padding: they inset the hover highlight from the popup edge. -->
        <Thickness x:Key="FlyoutBorderThemePadding">4,4,4,4</Thickness>
        <Thickness x:Key="MenuFlyoutScrollerMargin">0</Thickness>
        <SolidColorBrush x:Key="MenuFlyoutItemBackground" Color="Transparent" />
        <SolidColorBrush
            x:Key="MenuFlyoutItemBackgroundPointerOver"
            Color="{StaticResource RaisedColor}"
        />
        <SolidColorBrush
            x:Key="MenuFlyoutItemBackgroundPressed"
            Color="{StaticResource LineColor}"
        />
        <SolidColorBrush x:Key="MenuFlyoutItemForeground" Color="{StaticResource TextColor}" />
        <SolidColorBrush
            x:Key="MenuFlyoutItemForegroundPointerOver"
            Color="{StaticResource TextColor}"
        />
        <SolidColorBrush
            x:Key="MenuFlyoutItemForegroundPressed"
            Color="{StaticResource TextColor}"
        />
        <SolidColorBrush
            x:Key="MenuFlyoutItemForegroundDisabled"
            Color="{StaticResource MutedColor}"
        />
        <SolidColorBrush x:Key="MenuFlyoutSeparatorBackground" Color="{StaticResource LineColor}" />
        <Thickness x:Key="MenuFlyoutItemThemePaddingNarrow">12,7,16,7</Thickness>
        <SolidColorBrush x:Key="FlyoutPresenterBackground" Color="{StaticResource PanelColor}" />
        <SolidColorBrush x:Key="FlyoutBorderThemeBrush" Color="{StaticResource LineColor}" />
        <SolidColorBrush x:Key="ComboBoxDropDownBackground" Color="{StaticResource PanelColor}" />
        <SolidColorBrush x:Key="ComboBoxDropDownBorderBrush" Color="{StaticResource LineColor}" />
        <SolidColorBrush
            x:Key="ComboBoxItemBackgroundPointerOver"
            Color="{StaticResource RaisedColor}"
        />
        <SolidColorBrush
            x:Key="ComboBoxItemBackgroundSelected"
            Color="{StaticResource RaisedColor}"
        />
        <SolidColorBrush
            x:Key="ComboBoxItemBackgroundSelectedPointerOver"
            Color="{StaticResource RaisedColor}"
        />
        <SolidColorBrush
            x:Key="ComboBoxItemBackgroundSelectedPressed"
            Color="{StaticResource LineColor}"
        />
        <SolidColorBrush
            x:Key="ComboBoxItemForegroundSelected"
            Color="{StaticResource TextColor}"
        />
        <SolidColorBrush
            x:Key="ComboBoxItemForegroundSelectedPointerOver"
            Color="{StaticResource TextColor}"
        />
        <SolidColorBrush x:Key="ComboBoxBackground" Color="{StaticResource PanelColor}" />
        <SolidColorBrush
            x:Key="ComboBoxBackgroundPointerOver"
            Color="{StaticResource RaisedColor}"
        />
        <SolidColorBrush x:Key="ComboBoxBorderBrush" Color="{StaticResource LineColor}" />
        <SolidColorBrush
            x:Key="ComboBoxBorderBrushPointerOver"
            Color="{StaticResource LineColor}"
        />
        <CornerRadius x:Key="OverlayCornerRadius">8</CornerRadius>
        <FontFamily x:Key="Sans">
            IBM Plex Sans, Cantarell, DejaVu Sans, Inter, system-ui, sans-serif
        </FontFamily>
        <FontFamily x:Key="Mono">
            IBM Plex Mono, JetBrains Mono, DejaVu Sans Mono, Consolas, monospace
        </FontFamily>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />
        <StyleInclude Source="avares://steamrip-desktop/Views/Styles.axaml" />
    </Application.Styles>

    <TrayIcon.Icons>
        <TrayIcons>
            <TrayIcon
                Icon="avares://steamrip-desktop/Assets/tray.png"
                ToolTipText="SteamRIP Desktop"
                Clicked="TrayIcon_OnClicked"
            >
                <TrayIcon.Menu>
                    <NativeMenu>
                        <NativeMenuItem Header="Open library" Click="Show_OnClick" />
                        <NativeMenuItem Header="Check for updates now" Click="CheckNow_OnClick" />
                        <NativeMenuItem
                            Header="Pause auto-updates"
                            ToggleType="CheckBox"
                            Click="Pause_OnClick"
                        />
                        <NativeMenuItemSeparator />
                        <NativeMenuItem Header="Quit" Click="Quit_OnClick" />
                    </NativeMenu>
                </TrayIcon.Menu>
            </TrayIcon>
        </TrayIcons>
    </TrayIcon.Icons>
</Application>
