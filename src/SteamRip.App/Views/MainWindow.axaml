<Window
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:SteamRip.App.ViewModels"
    x:Class="SteamRip.App.Views.MainWindow"
    x:DataType="vm:MainViewModel"
    Title="SteamRIP Desktop"
    Width="1040"
    Height="700"
    MinWidth="820"
    MinHeight="520"
    Icon="avares://steamrip-desktop/Assets/app.png"
>
    <Window.DataTemplates>
        <!-- ============ LAUNCH TWEAKS (shared by Settings defaults and the per-game flyout) ============ -->
        <DataTemplate DataType="vm:LaunchOptionsEditor">
            <StackPanel Spacing="8">
                <TextBlock
                    Classes="muted"
                    TextWrapping="Wrap"
                    Text="Only the environment and wrapper apply on Windows; the rest is for Proton on Linux."
                    IsVisible="{Binding !IsLinux}"
                />
                <UniformGrid Columns="2" IsEnabled="{Binding IsLinux}">
                    <CheckBox Content="{Binding MangoHudLabel}" IsChecked="{Binding MangoHud}" />
                    <CheckBox Content="{Binding GameModeLabel}" IsChecked="{Binding GameMode}" />
                    <CheckBox Content="{Binding GamescopeLabel}" IsChecked="{Binding Gamescope}" />
                    <CheckBox Content="{Binding HdrLabel}" IsChecked="{Binding Hdr}" />
                    <CheckBox Content="{Binding WaylandLabel}" IsChecked="{Binding Wayland}" />
                    <CheckBox Content="{Binding FsrLabel}" IsChecked="{Binding Fsr}" />
                    <CheckBox Content="{Binding FsyncLabel}" IsChecked="{Binding Fsync}" />
                    <CheckBox
                        Content="{Binding ProtonLogLabel}"
                        IsChecked="{Binding ProtonLog}"
                        ToolTip.Tip="PROTON_LOG=1: Wine writes its debug channels to a file in your home directory. Turn it on when a game does not start, then look for err:, 'unimplemented function' or 'Unhandled exception'."
                    />
                </UniformGrid>
                <TextBlock
                    Classes="amber"
                    TextWrapping="Wrap"
                    Text="{Binding HdrWarning}"
                    IsVisible="{Binding HasHdrWarning}"
                />
                <Grid ColumnDefinitions="*,12,*" IsEnabled="{Binding IsLinux}">
                    <StackPanel Grid.Column="0" Spacing="4">
                        <TextBlock Classes="label" Text="Gamescope arguments" />
                        <TextBox
                            Text="{Binding GamescopeArgs}"
                            PlaceholderText="{Binding GamescopeArgsPlaceholder}"
                            FontFamily="{StaticResource Mono}"
                            FontSize="12"
                        />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Spacing="4">
                        <TextBlock Classes="label" Text="MangoHud config" />
                        <TextBox
                            Text="{Binding MangoHudConfig}"
                            PlaceholderText="{Binding MangoHudConfigPlaceholder}"
                            FontFamily="{StaticResource Mono}"
                            FontSize="12"
                        />
                    </StackPanel>
                </Grid>
                <TextBlock Classes="label" Text="DLL overrides" IsVisible="{Binding IsLinux}" />
                <TextBox
                    Text="{Binding DllOverrides}"
                    PlaceholderText="{Binding DllOverridesPlaceholder}"
                    FontFamily="{StaticResource Mono}"
                    FontSize="12"
                    IsVisible="{Binding IsLinux}"
                />
                <TextBlock
                    Classes="eyebrow"
                    Text="ENVIRONMENT (KEY=VALUE PER LINE, APPLIED LAST)"
                />
                <TextBox
                    Text="{Binding Environment}"
                    PlaceholderText="{Binding EnvironmentPlaceholder}"
                    AcceptsReturn="True"
                    MinHeight="64"
                    FontFamily="{StaticResource Mono}"
                    FontSize="12"
                />
                <TextBlock Classes="eyebrow" Text="WRAPPER COMMAND" />
                <TextBox
                    Text="{Binding Wrapper}"
                    PlaceholderText="{Binding WrapperPlaceholder}"
                    FontFamily="{StaticResource Mono}"
                    FontSize="12"
                />
                <Button
                    Classes="quiet"
                    Content="Back to Settings defaults"
                    Command="{Binding ResetCommand}"
                    HorizontalAlignment="Left"
                    IsVisible="{Binding IsPerGame}"
                />
            </StackPanel>
        </DataTemplate>

        <!-- ============ LIBRARY ============ -->
        <DataTemplate DataType="vm:LibraryViewModel">
            <DockPanel Margin="28,24,28,20">
                <StackPanel DockPanel.Dock="Top" Margin="0,0,0,18" Spacing="3">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <TextBlock Classes="h1" Text="Library" VerticalAlignment="Center" />
                        <Border
                            Classes="pill amber"
                            VerticalAlignment="Center"
                            IsVisible="{Binding UpdatesAvailable}"
                        >
                            <TextBlock Text="{Binding UpdatesLabel}" />
                        </Border>
                    </StackPanel>
                </StackPanel>
                <StackPanel
                    DockPanel.Dock="Top"
                    Spacing="14"
                    Margin="0,6,0,24"
                    IsVisible="{Binding IsEmpty}"
                >
                    <TextBlock
                        Classes="h1"
                        FontSize="26"
                        Text="Nothing installed yet."
                        Margin="0,0,0,-6"
                    />
                    <TextBlock
                        Classes="muted"
                        TextWrapping="Wrap"
                        MaxWidth="560"
                        HorizontalAlignment="Left"
                        LineHeight="19"
                        Text="Browse the catalog and pick a game. It downloads, checks the archive, extracts into your library and gets its own Proton prefix on first play. Updates arrive on their own."
                    />
                    <Button
                        Classes="primary"
                        Content="Browse the catalog"
                        Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).NavigateCommand}"
                        CommandParameter="Browse"
                        HorizontalAlignment="Left"
                        Padding="14,7"
                    />
                </StackPanel>
                <TextBlock
                    DockPanel.Dock="Top"
                    Classes="red"
                    Margin="0,0,0,10"
                    TextWrapping="Wrap"
                    Text="{Binding LastError}"
                    IsVisible="{Binding LastError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                />
                <ListBox ItemsSource="{Binding Items}" Classes="plain">
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="vm:LibraryItem">
                            <Border Classes="row">
                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                                    <Border Classes="cover" Width="44" Height="60">
                                        <Panel>
                                            <TextBlock
                                                Classes="coverInitial"
                                                Text="{Binding Initial}"
                                                IsVisible="{Binding Cover, Converter={x:Static ObjectConverters.IsNull}}"
                                            />
                                            <Image
                                                Source="{Binding Cover}"
                                                Stretch="UniformToFill"
                                            />
                                        </Panel>
                                    </Border>
                                    <StackPanel
                                        Grid.Column="1"
                                        Spacing="3"
                                        VerticalAlignment="Center"
                                    >
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBlock
                                                Text="{Binding Name}"
                                                FontWeight="SemiBold"
                                                FontSize="14.5"
                                                TextTrimming="CharacterEllipsis"
                                            />
                                            <Border Classes="pill" IsVisible="{Binding IsRunning}">
                                                <TextBlock Classes="green" Text="running" />
                                            </Border>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Spacing="10">
                                            <TextBlock
                                                Classes="mono muted"
                                                FontSize="11"
                                                Text="{Binding InstalledVersion}"
                                            />
                                            <TextBlock
                                                Classes="mono amber"
                                                FontSize="11"
                                                Text="{Binding SiteVersion}"
                                                IsVisible="{Binding HasUpdate}"
                                            />
                                            <TextBlock Classes="meta" Text="{Binding SizeText}" />
                                            <TextBlock Classes="meta" Text="{Binding Playtime}" />
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBlock
                                                Classes="meta"
                                                Text="{Binding StatusLine}"
                                                TextTrimming="CharacterEllipsis"
                                            />
                                            <TextBlock
                                                Classes="mono muted"
                                                FontSize="10.5"
                                                Text="{Binding ExeLine}"
                                                TextTrimming="CharacterEllipsis"
                                            />
                                        </StackPanel>
                                    </StackPanel>
                                    <StackPanel
                                        Grid.Column="2"
                                        Orientation="Horizontal"
                                        Spacing="4"
                                        VerticalAlignment="Center"
                                    >
                                        <Button
                                            Classes="primary"
                                            Content="Play"
                                            Command="{Binding PlayCommand}"
                                            IsVisible="{Binding !IsRunning}"
                                            IsEnabled="{Binding CanPlay}"
                                            MinWidth="64"
                                        />
                                        <Button
                                            Classes="danger"
                                            Content="Stop"
                                            Command="{Binding StopCommand}"
                                            IsVisible="{Binding IsRunning}"
                                            MinWidth="64"
                                        />
                                        <Button
                                            Classes="quiet"
                                            Content="Update"
                                            Command="{Binding UpdateNowCommand}"
                                            IsVisible="{Binding HasUpdate}"
                                            IsEnabled="{Binding IsIdle}"
                                            Foreground="{StaticResource Amber}"
                                        />
                                        <Button
                                            Classes="link"
                                            Content="Options"
                                            Command="{Binding OptionsCommand}"
                                        />
                                        <Button Classes="link" Content="···">
                                            <Button.Flyout>
                                                <MenuFlyout>
                                                    <MenuItem
                                                        Header="{Binding AutoLabel}"
                                                        Command="{Binding ToggleAutoCommand}"
                                                    />
                                                    <Separator />
                                                    <MenuItem
                                                        Header="{Binding MenuShortcutLabel}"
                                                        Command="{Binding ToggleMenuShortcutCommand}"
                                                    />
                                                    <MenuItem
                                                        Header="{Binding DesktopShortcutLabel}"
                                                        Command="{Binding ToggleDesktopShortcutCommand}"
                                                    />
                                                    <Separator IsVisible="{Binding IsLinux}" />
                                                    <MenuItem
                                                        Header="Winetricks"
                                                        Command="{Binding WinetricksCommand}"
                                                        IsVisible="{Binding IsLinux}"
                                                        ToolTip.Tip="Open winetricks against this game's Proton prefix (same Proton wine as Play)"
                                                    />
                                                    <MenuItem
                                                        Header="Run exe…"
                                                        Command="{Binding RunExeCommand}"
                                                        IsVisible="{Binding IsLinux}"
                                                        ToolTip.Tip="Run an .exe or .msi (for example from _CommonRedist) inside this game's prefix"
                                                    />
                                                    <MenuItem
                                                        Header="Prefix info"
                                                        Command="{Binding PrefixInfoCommand}"
                                                        IsVisible="{Binding IsLinux}"
                                                        ToolTip.Tip="Size, Proton build and launch count of this game's Wine prefix (also in the log)"
                                                    />
                                                    <MenuItem
                                                        Header="Reset prefix (moves it aside)"
                                                        Command="{Binding ResetPrefixCommand}"
                                                        IsVisible="{Binding IsLinux}"
                                                        ToolTip.Tip="Move the prefix to a .bak folder and let the next launch build a clean one. Nothing is deleted."
                                                    />
                                                    <Separator />
                                                    <MenuItem
                                                        Header="Forget (keep files)"
                                                        Command="{Binding ForgetCommand}"
                                                    />
                                                    <MenuItem
                                                        Classes="danger"
                                                        Header="Uninstall and delete files"
                                                        Command="{Binding DeleteCommand}"
                                                    />
                                                </MenuFlyout>
                                            </Button.Flyout>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </DataTemplate>

        <!-- ============ BROWSE ============ -->
        <DataTemplate DataType="vm:BrowseViewModel">
            <DockPanel Margin="28,24,28,20">
                <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="6">
                            <Button
                                Classes="quiet"
                                Content="Sync now"
                                Command="{Binding SyncCommand}"
                            />
                            <Button
                                Classes="quiet"
                                Content="Full re-sync"
                                Command="{Binding FullSyncCommand}"
                                ToolTip.Tip="Re-fetch all ~5,000 posts (about 50 requests)"
                            />
                        </StackPanel>
                        <TextBlock Classes="h1" Text="Browse" />
                    </DockPanel>
                </StackPanel>
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                    <StackPanel
                        DockPanel.Dock="Right"
                        Orientation="Horizontal"
                        Spacing="6"
                        Margin="8,0,0,0"
                    >
                        <ComboBox
                            ItemsSource="{Binding Genres}"
                            SelectedItem="{Binding Genre}"
                            DisplayMemberBinding="{Binding Name}"
                            MinWidth="170"
                            VerticalAlignment="Center"
                            ToolTip.Tip="Genre (the site's categories)"
                        />
                        <ComboBox
                            ItemsSource="{Binding Sorts}"
                            SelectedItem="{Binding Sort}"
                            DisplayMemberBinding="{Binding Label}"
                            MinWidth="170"
                            VerticalAlignment="Center"
                            ToolTip.Tip="Sort order"
                        />
                    </StackPanel>
                    <TextBox PlaceholderText="Search by name…" Text="{Binding Query}" />
                </DockPanel>
                <TextBlock
                    DockPanel.Dock="Top"
                    Classes="meta"
                    Text="{Binding Summary}"
                    TextWrapping="Wrap"
                    Margin="0,-4,0,14"
                />
                <StackPanel
                    DockPanel.Dock="Top"
                    Spacing="12"
                    Margin="0,10,0,0"
                    IsVisible="{Binding IsEmpty}"
                >
                    <StackPanel Spacing="12" IsVisible="{Binding !HasCatalog}">
                        <TextBlock Classes="h2" Text="No catalog yet." />
                        <TextBlock
                            Classes="meta"
                            MaxWidth="520"
                            HorizontalAlignment="Left"
                            TextWrapping="Wrap"
                            Text="The first sync starts a few seconds after launch and takes a minute. If nothing appears, press Sync now."
                        />
                        <Button
                            Classes="quiet"
                            Content="Sync now"
                            Command="{Binding SyncCommand}"
                            HorizontalAlignment="Left"
                        />
                    </StackPanel>
                    <StackPanel Spacing="12" IsVisible="{Binding HasCatalog}">
                        <TextBlock Classes="h2" Text="Nothing matches that." />
                        <TextBlock
                            Classes="meta"
                            MaxWidth="520"
                            HorizontalAlignment="Left"
                            TextWrapping="Wrap"
                            Text="Clear the search or pick another genre. The catalog itself is still there."
                        />
                        <Button
                            Classes="quiet"
                            Content="Clear filters"
                            Command="{Binding ClearFiltersCommand}"
                            HorizontalAlignment="Left"
                        />
                    </StackPanel>
                </StackPanel>
                <ListBox ItemsSource="{Binding Items}" Classes="plain">
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="vm:BrowseItem">
                            <Border Classes="row" Padding="16,10">
                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="2">
                                    <Border
                                        Grid.Column="0"
                                        Classes="cover"
                                        Width="44"
                                        Height="66"
                                        Margin="0,0,12,0"
                                    >
                                        <Panel>
                                            <TextBlock
                                                Classes="coverInitial"
                                                FontSize="18"
                                                Text="{Binding Initial}"
                                                IsVisible="{Binding Cover, Converter={x:Static ObjectConverters.IsNull}}"
                                            />
                                            <Image
                                                Source="{Binding Cover}"
                                                Stretch="UniformToFill"
                                            />
                                        </Panel>
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal" Spacing="10">
                                            <TextBlock
                                                Text="{Binding Name}"
                                                FontWeight="SemiBold"
                                                FontSize="14"
                                            />
                                            <TextBlock
                                                Classes="mono muted"
                                                Text="{Binding Version}"
                                                VerticalAlignment="Center"
                                            />
                                        </StackPanel>
                                        <TextBlock Classes="meta" Margin="0,3,0,0">
                                            <Run Text="{Binding Size}" />
                                            <Run Text=", updated " />
                                            <Run Text="{Binding Updated}" />
                                            <Run Text=", via " />
                                            <Run Text="{Binding Mirrors}" />
                                        </TextBlock>
                                    </StackPanel>
                                    <StackPanel
                                        Grid.Column="2"
                                        Orientation="Horizontal"
                                        Spacing="6"
                                        VerticalAlignment="Center"
                                    >
                                        <Border Classes="pill" IsVisible="{Binding Installed}">
                                            <TextBlock
                                                FontSize="11"
                                                Classes="green"
                                                Text="In library"
                                            />
                                        </Border>
                                        <Border
                                            Classes="pill"
                                            IsVisible="{Binding Unsupported}"
                                            ToolTip.Tip="This post only has mirrors the app can't resolve (1fichier, FileCrypt…)"
                                        >
                                            <TextBlock
                                                FontSize="11"
                                                Classes="muted"
                                                Text="No supported mirror"
                                            />
                                        </Border>
                                        <Button
                                            Classes="action"
                                            Content="Install"
                                            Command="{Binding InstallCommand}"
                                            IsVisible="{Binding CanInstall}"
                                        />
                                        <Button
                                            Classes="quiet"
                                            Content="Page"
                                            Command="{Binding OpenPageCommand}"
                                        />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </DataTemplate>

        <!-- ============ QUEUE ============ -->
        <DataTemplate DataType="vm:QueueViewModel">
            <DockPanel Margin="28,24,28,20">
                <Grid DockPanel.Dock="Top" Margin="0,0,0,20" ColumnDefinitions="*,Auto">
                    <StackPanel Spacing="3">
                        <TextBlock Classes="h1" Text="Queue" />
                        <TextBlock
                            Classes="meta"
                            Text="One job at a time. Updates queue themselves; installs start when you press Install."
                        />
                    </StackPanel>
                    <StackPanel
                        Grid.Column="1"
                        Orientation="Horizontal"
                        Spacing="10"
                        VerticalAlignment="Center"
                    >
                        <ToggleSwitch
                            IsChecked="{Binding Paused}"
                            OnContent="Auto-updates paused"
                            OffContent="Auto-updates on"
                        />
                        <Button
                            Classes="quiet"
                            Content="Clear finished"
                            Command="{Binding ClearFinishedCommand}"
                        />
                    </StackPanel>
                </Grid>

                <StackPanel
                    DockPanel.Dock="Top"
                    Spacing="10"
                    Margin="0,4,0,0"
                    IsVisible="{Binding IsEmpty}"
                >
                    <TextBlock Classes="h2" Text="Nothing queued." />
                    <TextBlock
                        Classes="meta"
                        TextWrapping="Wrap"
                        MaxWidth="520"
                        HorizontalAlignment="Left"
                        Text="Updates land here on their own when the catalog changes. Start something from Browse and it appears here while it downloads."
                    />
                </StackPanel>

                <ScrollViewer>
                    <ItemsControl ItemsSource="{Binding Items}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="vm:JobItem">
                                <Border Classes="row" Padding="16,12,16,10">
                                    <StackPanel>
                                        <Grid ColumnDefinitions="*,Auto">
                                            <StackPanel Spacing="4">
                                                <StackPanel Orientation="Horizontal" Spacing="10">
                                                    <TextBlock
                                                        Text="{Binding Name}"
                                                        FontWeight="SemiBold"
                                                        FontSize="14.5"
                                                        VerticalAlignment="Center"
                                                    />
                                                    <Border Classes="pill">
                                                        <TextBlock Text="{Binding Kind}" />
                                                    </Border>
                                                    <TextBlock
                                                        Classes="mono muted"
                                                        FontSize="11"
                                                        Text="{Binding Version}"
                                                        VerticalAlignment="Center"
                                                    />
                                                </StackPanel>
                                                <TextBlock
                                                    Text="{Binding Status}"
                                                    TextWrapping="Wrap"
                                                    Classes.muted="{Binding Active}"
                                                    Classes.red="{Binding NeedsAttention}"
                                                    Classes.green="{Binding Done}"
                                                />
                                            </StackPanel>
                                            <StackPanel
                                                Grid.Column="1"
                                                Orientation="Horizontal"
                                                Spacing="4"
                                                VerticalAlignment="Center"
                                            >
                                                <Button
                                                    Classes="action"
                                                    Content="Solve in browser"
                                                    Command="{Binding SolveInBrowserCommand}"
                                                    IsVisible="{Binding NeedsAttention}"
                                                    IsEnabled="{Binding CanSolveInBrowser}"
                                                    ToolTip.Tip="Opens a visible Chromium on the FileDitch mirror so you can pass its check; the download then continues here."
                                                />
                                                <Button
                                                    Classes="quiet"
                                                    Content="Retry"
                                                    Command="{Binding RetryCommand}"
                                                    IsVisible="{Binding Failed}"
                                                />
                                                <Button
                                                    Classes="quiet"
                                                    Content="Retry"
                                                    Command="{Binding RetryCommand}"
                                                    IsVisible="{Binding NeedsAttention}"
                                                />
                                                <Button
                                                    Classes="danger"
                                                    Content="Cancel"
                                                    Command="{Binding CancelCommand}"
                                                    IsVisible="{Binding Active}"
                                                />
                                            </StackPanel>
                                        </Grid>
                                        <ProgressBar
                                            Margin="0,10,0,0"
                                            Value="{Binding Fraction}"
                                            Maximum="1"
                                            IsIndeterminate="{Binding Indeterminate}"
                                            IsVisible="{Binding Active}"
                                        />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </DataTemplate>

        <!-- ============ ACTIVITY ============ -->
        <DataTemplate DataType="vm:ActivityViewModel">
            <Grid Margin="28,24,28,20" RowDefinitions="Auto,*,Auto,2*">
                <StackPanel Margin="0,0,0,16" Spacing="3">
                    <TextBlock Classes="h1" Text="Activity" />
                    <TextBlock
                        Classes="meta"
                        Text="What the app did, newest first. Every line is also in the log file."
                    />
                </StackPanel>

                <Border
                    Grid.Row="1"
                    BorderBrush="{StaticResource Line}"
                    BorderThickness="1"
                    Padding="0"
                >
                    <ScrollViewer>
                        <ItemsControl ItemsSource="{Binding Events}" Margin="14,10">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="vm:ActivityLine">
                                    <Grid ColumnDefinitions="92,74,*" Margin="0,3">
                                        <TextBlock
                                            Classes="mono muted"
                                            FontSize="11"
                                            Text="{Binding When}"
                                        />
                                        <TextBlock
                                            Grid.Column="1"
                                            Classes="mono"
                                            FontSize="11"
                                            Text="{Binding Kind}"
                                            Classes.red="{Binding IsError}"
                                            Classes.muted="{Binding !IsError}"
                                        />
                                        <TextBlock
                                            Grid.Column="2"
                                            FontSize="12.5"
                                            Text="{Binding Message}"
                                            TextWrapping="Wrap"
                                        />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Border>

                <Grid Grid.Row="2" ColumnDefinitions="*,Auto" Margin="0,18,0,8">
                    <StackPanel Spacing="2" VerticalAlignment="Center">
                        <TextBlock Classes="label" Text="Session log" />
                        <TextBlock
                            Classes="mono muted"
                            FontSize="10.5"
                            Text="{Binding LogDir}"
                            TextTrimming="CharacterEllipsis"
                        />
                    </StackPanel>
                    <Button
                        Grid.Column="1"
                        Classes="quiet"
                        Content="Open log folder"
                        Command="{Binding OpenLogDirCommand}"
                        VerticalAlignment="Center"
                    />
                </Grid>

                <Border
                    Grid.Row="3"
                    BorderBrush="{StaticResource Line}"
                    BorderThickness="1"
                    Padding="0"
                >
                    <ScrollViewer>
                        <ItemsControl ItemsSource="{Binding Live}" Margin="14,10">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="x:String">
                                    <TextBlock
                                        Classes="mono muted"
                                        FontSize="11"
                                        Text="{Binding}"
                                        TextWrapping="Wrap"
                                        Margin="0,1"
                                    />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Border>
            </Grid>
        </DataTemplate>

        <!-- ============ SETTINGS ============ -->
        <DataTemplate DataType="vm:SettingsViewModel">
            <ScrollViewer>
                <StackPanel
                    Margin="28,24,28,20"
                    Spacing="14"
                    MaxWidth="760"
                    HorizontalAlignment="Left"
                >
                    <StackPanel Spacing="3">
                        <TextBlock Classes="h1" Text="Settings" />
                        <TextBlock
                            Classes="meta"
                            Text="Saved as you type. Paths apply to new installs; the Proton and download choices to the next launch or job."
                        />
                    </StackPanel>

                    <Border Classes="section">
                        <StackPanel Spacing="10">
                            <TextBlock Classes="h2" Text="Folders" />
                            <TextBlock
                                MaxWidth="640"
                                HorizontalAlignment="Left"
                                Classes="meta"
                                Text="Games are extracted to &lt;library&gt;/&lt;game-slug&gt;. Each keeps its own Wine prefix outside the game folder (default &lt;library&gt;/.prefixes/&lt;game-slug&gt;), so an update swap, an uninstall or a delete cannot take the saves with it; prefixes still sitting in a game folder are moved there on the next launch. Archives land in the downloads folder and are deleted after install unless you say otherwise."
                                TextWrapping="Wrap"
                            />
                            <Grid ColumnDefinitions="200,*" ColumnSpacing="18">
                                <TextBlock
                                    Classes="label"
                                    Text="Library folder"
                                    TextWrapping="Wrap"
                                    VerticalAlignment="Center"
                                />
                                <ContentControl Grid.Column="1">
                                    <TextBox Text="{Binding LibraryRoot}" />
                                </ContentControl>
                            </Grid>
                            <Grid ColumnDefinitions="200,*" ColumnSpacing="18">
                                <TextBlock
                                    Classes="label"
                                    Text="Downloads folder"
                                    TextWrapping="Wrap"
                                    VerticalAlignment="Center"
                                />
                                <ContentControl Grid.Column="1">
                                    <TextBox Text="{Binding DownloadsRoot}" />
                                </ContentControl>
                            </Grid>
                            <Grid ColumnDefinitions="200,*" ColumnSpacing="18">
                                <TextBlock
                                    Classes="label"
                                    Text="Prefixes folder"
                                    TextWrapping="Wrap"
                                    VerticalAlignment="Center"
                                />
                                <StackPanel Grid.Column="1" Spacing="10">
                                    <TextBox
                                        Text="{Binding PrefixRoot}"
                                        PlaceholderText="{Binding LibraryRoot}"
                                    />
                                    <TextBlock
                                        Classes="meta"
                                        TextWrapping="Wrap"
                                        Text="Empty means &lt;library&gt;/.prefixes."
                                    />
                                    <ToggleSwitch
                                        IsChecked="{Binding DeletePrefixOnUninstall}"
                                        OnContent="Delete the prefix when uninstalling (saves go too)"
                                        OffContent="Keep the prefix when uninstalling (saves stay)"
                                    />
                                </StackPanel>
                            </Grid>
                            <Grid ColumnDefinitions="200,*" ColumnSpacing="18">
                                <TextBlock
                                    Classes="label"
                                    Text="Save backups to keep per game"
                                    TextWrapping="Wrap"
                                    VerticalAlignment="Center"
                                />
                                <StackPanel Grid.Column="1" Spacing="10">
                                    <NumericUpDown
                                        Value="{Binding KeepBackups}"
                                        Minimum="0"
                                        Maximum="10"
                                        Width="140"
                                        HorizontalAlignment="Left"
                                    />
                                    <ToggleSwitch
                                        IsChecked="{Binding DeleteArchiveAfterInstall}"
                                        OnContent="Delete archive after install"
                                        OffContent="Keep archive after install"
                                    />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Classes="section">
                        <StackPanel Spacing="10">
                            <TextBlock Classes="h2" Text="Downloads" />
                            <TextBlock
                                Classes="muted"
                                TextWrapping="Wrap"
                                Text="aria2 splits a transfer over many connections, resumes a half-finished file, retries a host that hung up, checks the hash the hoster published and opens the .torrent mirrors some hosters serve instead of an archive. Without it the app falls back to its own single-connection downloader."
                            />
                            <Grid ColumnDefinitions="200,*" ColumnSpacing="18">
                                <TextBlock
                                    Classes="label"
                                    Text="Engine"
                                    TextWrapping="Wrap"
                                    VerticalAlignment="Center"
                                />
                                <ContentControl Grid.Column="1">
                                    <ComboBox
                                        ItemsSource="{Binding Engines}"
                                        SelectedItem="{Binding DownloadEngine}"
                                        HorizontalAlignment="Stretch"
                                    />
                                </ContentControl>
                            </Grid>
                            <ToggleSwitch
                                IsChecked="{Binding TorrentMirrors}"
                                OnContent="Use .torrent mirrors when no direct link resolves"
                                OffContent="Skip .torrent mirrors (direct files only)"
                            />
                            <TextBlock
                                Classes="mono muted"
                                Text="{Binding DownloadLine}"
                                TextWrapping="Wrap"
                            />
                        </StackPanel>
                    </Border>

                    <Border Classes="section">
                        <StackPanel Spacing="10">
                            <TextBlock Classes="h2" Text="Playing" />
                            <TextBlock
                                Classes="muted"
                                TextWrapping="Wrap"
                                Text="Games run through umu-run with the Proton build below (per-game override in Launch options). GE-Proton and DW-Proton are downloaded on first use and kept current; expect a wait that one time, and the same for umu's runtime."
                            />
                            <Grid ColumnDefinitions="200,*" ColumnSpacing="18">
                                <TextBlock
                                    Classes="label"
                                    Text="Default Proton"
                                    TextWrapping="Wrap"
                                    VerticalAlignment="Center"
                                />
                                <ContentControl Grid.Column="1">
                                    <ComboBox
                                        ItemsSource="{Binding Protons}"
                                        SelectedItem="{Binding DefaultProton}"
                                        HorizontalAlignment="Stretch"
                                    />
                                </ContentControl>
                            </Grid>
                            <TextBlock
                                Classes="mono muted"
                                Text="{Binding LauncherLine}"
                                TextWrapping="Wrap"
                            />
                        </StackPanel>
                    </Border>

                    <Border Classes="section">
                        <StackPanel Spacing="10">
                            <TextBlock Classes="h2" Text="Launch defaults" />
                            <TextBlock
                                Classes="muted"
                                TextWrapping="Wrap"
                                Text="Applied to every game unless its Launch options say otherwise. Missing tools are skipped with a note in the log, never a failed launch. HDR needs a Wayland session and either gamescope or Wine's Wayland driver; the check below tells you which you have."
                            />
                            <ContentControl Content="{Binding Launch}" />
                            <DockPanel Margin="0,6,0,0">
                                <Button
                                    DockPanel.Dock="Right"
                                    Classes="quiet"
                                    Content="Re-check"
                                    Command="{Binding RecheckCommand}"
                                    VerticalAlignment="Top"
                                />
                                <StackPanel Spacing="4">
                                    <TextBlock Classes="eyebrow" Text="CAPABILITY CHECK" />
                                    <TextBlock
                                        Classes="mono muted"
                                        Text="{Binding CapabilityText}"
                                        TextWrapping="Wrap"
                                    />
                                </StackPanel>
                            </DockPanel>
                        </StackPanel>
                    </Border>

                    <Border Classes="section">
                        <StackPanel Spacing="10">
                            <TextBlock Classes="h2" Text="Mirrors and Cloudflare" />
                            <TextBlock
                                Classes="muted"
                                TextWrapping="Wrap"
                                Text="FileDitch and BuzzHeavier pages sit behind browser checks; FlareSolverr passes them for you. GoFile and MegaDB need nothing. If every automatic route fails, the queue offers 'Solve in browser'."
                            />
                            <TextBlock Text="FlareSolverr URL" Classes="label" />
                            <DockPanel>
                                <Button
                                    DockPanel.Dock="Right"
                                    Classes="quiet"
                                    Content="Test"
                                    Command="{Binding TestSolverCommand}"
                                    Margin="6,0,0,0"
                                />
                                <TextBox
                                    Text="{Binding FlareSolverrUrl, UpdateSourceTrigger=PropertyChanged}"
                                    PlaceholderText="http://192.168.1.10:8191"
                                    FontFamily="{StaticResource Mono}"
                                    FontSize="12"
                                />
                            </DockPanel>
                            <TextBlock
                                Classes="muted"
                                Text="{Binding SolverTest}"
                                IsVisible="{Binding SolverTest, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                            />
                            <Grid ColumnDefinitions="200,*" ColumnSpacing="18">
                                <TextBlock
                                    Classes="label"
                                    Text="SteamGridDB API key"
                                    TextWrapping="Wrap"
                                    VerticalAlignment="Center"
                                />
                                <ContentControl Grid.Column="1">
                                    <TextBox
                                        Text="{Binding SteamGridDbApiKey, UpdateSourceTrigger=PropertyChanged}"
                                        PasswordChar="•"
                                        PlaceholderText="Optional — free key from steamgriddb.com → Preferences"
                                        FontFamily="{StaticResource Mono}"
                                        FontSize="12"
                                    />
                                </ContentControl>
                            </Grid>
                            <TextBlock
                                Classes="muted"
                                TextWrapping="Wrap"
                                Text="Used for sharp 600×900 covers and shortcut icons. Without a key, covers fall back to Steam's library art. Clear covers/ after changing the key so cards re-fetch."
                            />
                            <TextBlock
                                Text="Mirror preference (comma-separated: FileDitch, GoFile, MegaDb, BuzzHeavier)"
                                Classes="muted"
                                TextWrapping="Wrap"
                            />
                            <TextBox
                                Text="{Binding HosterOrder}"
                                FontFamily="{StaticResource Mono}"
                                FontSize="12"
                            />
                        </StackPanel>
                    </Border>

                    <Border Classes="section">
                        <StackPanel Spacing="10">
                            <TextBlock Classes="h2" Text="Schedule and tray" />
                            <StackPanel Orientation="Horizontal" Spacing="16">
                                <StackPanel>
                                    <TextBlock
                                        Text="Check the catalog every (minutes)"
                                        Classes="label"
                                    />
                                    <NumericUpDown
                                        Value="{Binding CheckIntervalMinutes}"
                                        Minimum="5"
                                        Maximum="1440"
                                        Width="160"
                                    />
                                </StackPanel>
                            </StackPanel>
                            <ToggleSwitch
                                IsChecked="{Binding Autostart}"
                                OnContent="Start with the system (hidden in tray)"
                                OffContent="Don't start with the system"
                            />
                            <ToggleSwitch
                                IsChecked="{Binding StartHidden}"
                                OnContent="Start hidden in the tray"
                                OffContent="Show the window on start"
                            />
                            <ToggleSwitch
                                IsChecked="{Binding ShortcutMenu}"
                                OnContent="Add installed games to the app menu"
                                OffContent="No app menu entries for games"
                            />
                            <ToggleSwitch
                                IsChecked="{Binding ShortcutDesktop}"
                                OnContent="Put a shortcut for each game on the desktop"
                                OffContent="No desktop shortcuts for games"
                            />
                            <ToggleSwitch
                                IsChecked="{Binding NotifyNewGames}"
                                OnContent="Notify when new games are posted"
                                OffContent="Only notify about my games"
                            />
                            <Button
                                Classes="quiet"
                                Content="Send a test notification"
                                Command="{Binding TestNotificationCommand}"
                                HorizontalAlignment="Left"
                            />
                        </StackPanel>
                    </Border>

                    <Border Classes="section">
                        <StackPanel Spacing="6">
                            <TextBlock Classes="h2" Text="On this machine" />
                            <TextBlock Classes="mono muted" Text="{Binding VersionLine}" />
                            <TextBlock
                                Classes="mono muted"
                                Text="{Binding ToolsLine}"
                                TextWrapping="Wrap"
                            />
                            <TextBlock Classes="mono muted" Text="{Binding SecretsLine}" />
                            <DockPanel>
                                <Button
                                    DockPanel.Dock="Right"
                                    Classes="quiet"
                                    Content="Open"
                                    Command="{Binding OpenConfigDirCommand}"
                                />
                                <TextBlock
                                    Classes="mono muted"
                                    Text="{Binding ConfigDir}"
                                    VerticalAlignment="Center"
                                />
                            </DockPanel>
                            <DockPanel>
                                <Button
                                    DockPanel.Dock="Right"
                                    Classes="quiet"
                                    Content="Open"
                                    Command="{Binding OpenLogDirCommand}"
                                />
                                <TextBlock
                                    Classes="mono muted"
                                    Text="{Binding LogDir}"
                                    VerticalAlignment="Center"
                                />
                            </DockPanel>
                            <ToggleSwitch
                                IsChecked="{Binding VerboseLogging}"
                                OnContent="Verbose log (HTTP status codes, solver steps, page sizes)"
                                OffContent="Normal log (resolve, download, install, errors)"
                            />
                        </StackPanel>
                    </Border>

                    <TextBlock
                        Classes="muted"
                        Text="Changes save by themselves. Hoster order and FlareSolverr URL apply to the next job; library paths apply to new installs."
                        TextWrapping="Wrap"
                    />
                </StackPanel>
            </ScrollViewer>
        </DataTemplate>
    </Window.DataTemplates>

    <Panel>
        <Grid x:Name="Shell" ColumnDefinitions="216,*">
            <!-- Rail: where you are, what the machine is doing, and the one manual control. -->
            <Border
                x:Name="Rail"
                Background="{StaticResource Panel}"
                BorderBrush="{StaticResource Line}"
                BorderThickness="0,0,1,0"
            >
                <DockPanel Margin="14,18,14,14">
                    <StackPanel DockPanel.Dock="Top" Margin="6,0,0,24" Spacing="1">
                        <StackPanel Orientation="Horizontal" Spacing="9">
                            <Image
                                Source="avares://steamrip-desktop/Assets/app.png"
                                Width="20"
                                Height="20"
                            />
                            <TextBlock
                                Classes="nav-label"
                                Text="SteamRIP"
                                FontWeight="SemiBold"
                                FontSize="14.5"
                                VerticalAlignment="Center"
                            />
                        </StackPanel>
                        <TextBlock
                            Classes="mono muted nav-label"
                            FontSize="10.5"
                            Text="desktop client"
                            Margin="29,0,0,0"
                        />
                    </StackPanel>

                    <StackPanel
                        Classes="rail-status"
                        DockPanel.Dock="Bottom"
                        Spacing="8"
                        Margin="6,14,0,0"
                    >
                        <Border
                            Background="{StaticResource Ink}"
                            BorderBrush="{StaticResource Line}"
                            BorderThickness="1"
                            CornerRadius="3"
                            Padding="9,7"
                        >
                            <StackPanel Spacing="3">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <Ellipse
                                        Classes="dot"
                                        Fill="{StaticResource Green}"
                                        IsVisible="{Binding SolverHealthy}"
                                    />
                                    <Ellipse
                                        Classes="dot"
                                        Fill="{StaticResource Red}"
                                        IsVisible="{Binding !SolverHealthy}"
                                    />
                                    <TextBlock
                                        Classes="mono"
                                        FontSize="10.5"
                                        Text="challenge solver"
                                        Foreground="{StaticResource Muted}"
                                        ToolTip.Tip="{Binding SolverLine}"
                                    />
                                </StackPanel>
                                <TextBlock
                                    Classes="muted"
                                    FontSize="11"
                                    Text="{Binding SyncLine}"
                                    TextWrapping="Wrap"
                                    LineHeight="15"
                                />
                            </StackPanel>
                        </Border>
                        <Button
                            Classes="quiet"
                            Content="Sync now"
                            Command="{Binding SyncNowCommand}"
                            IsEnabled="{Binding !Syncing}"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Center"
                            Padding="10,5"
                            FontSize="12"
                        />
                    </StackPanel>

                    <StackPanel Spacing="1">
                        <Button
                            Classes="nav"
                            Command="{Binding NavigateCommand}"
                            CommandParameter="Library"
                            ToolTip.Tip="Library"
                            Classes.active="{Binding Section, Converter={x:Static ObjectConverters.Equal}, ConverterParameter=Library}"
                        >
                            <DockPanel>
                                <TextBlock Classes="nav-glyph" Text="L" />
                                <TextBlock Classes="nav-label" Text="Library" />
                            </DockPanel>
                        </Button>
                        <Button
                            Classes="nav"
                            Command="{Binding NavigateCommand}"
                            CommandParameter="Browse"
                            ToolTip.Tip="Browse"
                            Classes.active="{Binding Section, Converter={x:Static ObjectConverters.Equal}, ConverterParameter=Browse}"
                        >
                            <DockPanel>
                                <TextBlock Classes="nav-glyph" Text="B" />
                                <TextBlock Classes="nav-label" Text="Browse" />
                            </DockPanel>
                        </Button>
                        <Button
                            Classes="nav"
                            Command="{Binding NavigateCommand}"
                            CommandParameter="Queue"
                            ToolTip.Tip="Queue"
                            Classes.active="{Binding Section, Converter={x:Static ObjectConverters.Equal}, ConverterParameter=Queue}"
                        >
                            <DockPanel>
                                <TextBlock Classes="nav-glyph" Text="Q" />
                                <Border
                                    DockPanel.Dock="Right"
                                    Classes="pill amber nav-count"
                                    IsVisible="{Binding QueueCount}"
                                >
                                    <TextBlock Text="{Binding QueueCount}" />
                                </Border>
                                <Border
                                    DockPanel.Dock="Right"
                                    Classes="pill nav-count"
                                    Margin="0,0,4,0"
                                    IsVisible="{Binding AttentionCount}"
                                >
                                    <TextBlock Classes="red" Text="{Binding AttentionCount}" />
                                </Border>
                                <TextBlock Classes="nav-label" Text="Queue" />
                            </DockPanel>
                        </Button>
                        <Button
                            Classes="nav"
                            Command="{Binding NavigateCommand}"
                            CommandParameter="Activity"
                            ToolTip.Tip="Activity"
                            Classes.active="{Binding Section, Converter={x:Static ObjectConverters.Equal}, ConverterParameter=Activity}"
                        >
                            <DockPanel>
                                <TextBlock Classes="nav-glyph" Text="A" />
                                <TextBlock Classes="nav-label" Text="Activity" />
                            </DockPanel>
                        </Button>
                        <Button
                            Classes="nav"
                            Command="{Binding NavigateCommand}"
                            CommandParameter="Settings"
                            ToolTip.Tip="Settings"
                            Classes.active="{Binding Section, Converter={x:Static ObjectConverters.Equal}, ConverterParameter=Settings}"
                        >
                            <DockPanel>
                                <TextBlock Classes="nav-glyph" Text="S" />
                                <TextBlock Classes="nav-label" Text="Settings" />
                            </DockPanel>
                        </Button>
                    </StackPanel>
                </DockPanel>
            </Border>

            <ContentControl
                Grid.Column="1"
                Content="{Binding Current}"
                MaxWidth="1180"
                HorizontalAlignment="Left"
            />
        </Grid>

        <!-- Toast: one line, bottom left of the content column, gone on its own. -->
        <Border
            Classes="toast"
            HorizontalAlignment="Right"
            VerticalAlignment="Bottom"
            Margin="0,0,24,22"
            IsVisible="{Binding ToastVisible}"
        >
            <TextBlock Text="{Binding Toast}" FontSize="12.5" />
        </Border>

        <!-- Launch options: a sheet over the window, sectioned like Settings. -->
        <Panel IsVisible="{Binding IsEditing}">
            <Button
                Classes="backdrop"
                Command="{Binding CloseEditorCommand}"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
            />
            <Border x:Name="Sheet" Classes="sheet" HorizontalAlignment="Right" Width="560">
                <DockPanel>
                    <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="26,22,22,14">
                        <StackPanel Spacing="2">
                            <TextBlock Classes="mono muted" FontSize="10.5" Text="launch options" />
                            <TextBlock
                                Classes="h1"
                                Text="{Binding Editing.Name, FallbackValue=''}"
                                TextTrimming="CharacterEllipsis"
                            />
                        </StackPanel>
                        <Button
                            Grid.Column="1"
                            Classes="quiet"
                            Content="Close"
                            Command="{Binding CloseEditorCommand}"
                            VerticalAlignment="Top"
                        />
                    </Grid>
                    <ScrollViewer>
                        <StackPanel Margin="26,0,26,26" DataContext="{Binding Editing}">
                            <Border Classes="section" BorderThickness="0" Padding="0,0,0,16">
                                <StackPanel Spacing="8">
                                    <TextBlock Classes="h2" Text="Install folder" />
                                    <TextBox
                                        Text="{Binding CustomInstallPath}"
                                        PlaceholderText="{Binding DefaultInstallPath}"
                                        FontFamily="{StaticResource Mono}"
                                        FontSize="12"
                                    />
                                    <TextBlock
                                        Classes="meta"
                                        TextWrapping="Wrap"
                                        Text="Leave empty to use the library folder from Settings; an absolute path installs this game somewhere else."
                                    />
                                </StackPanel>
                            </Border>

                            <Border Classes="section">
                                <StackPanel Spacing="8">
                                    <TextBlock Classes="h2" Text="Executable and Proton" />
                                    <TextBlock Classes="label" Text="Executable" />
                                    <ComboBox
                                        ItemsSource="{Binding Exes}"
                                        SelectedItem="{Binding SelectedExe}"
                                        HorizontalAlignment="Stretch"
                                        FontFamily="{StaticResource Mono}"
                                        FontSize="12"
                                    />
                                    <TextBlock
                                        Classes="label"
                                        Text="Proton build"
                                        Margin="0,6,0,0"
                                    />
                                    <ComboBox
                                        ItemsSource="{Binding Protons}"
                                        SelectedItem="{Binding SelectedProton}"
                                        HorizontalAlignment="Stretch"
                                    />
                                    <TextBlock
                                        Classes="label"
                                        Text="Extra arguments"
                                        Margin="0,6,0,0"
                                    />
                                    <TextBox
                                        Text="{Binding LaunchArgs}"
                                        PlaceholderText="-windowed -nosplash"
                                        FontFamily="{StaticResource Mono}"
                                        FontSize="12"
                                    />
                                </StackPanel>
                            </Border>

                            <Border Classes="section">
                                <StackPanel Spacing="10">
                                    <StackPanel Spacing="2">
                                        <TextBlock Classes="h2" Text="Tweaks" />
                                        <TextBlock
                                            Classes="meta"
                                            TextWrapping="Wrap"
                                            Text="Starts from the Settings defaults; only what you change here is stored for this game."
                                        />
                                    </StackPanel>
                                    <ContentControl Content="{Binding Launch}" />
                                </StackPanel>
                            </Border>

                            <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,18,0,0">
                                <Button
                                    Classes="quiet"
                                    Content="Game folder"
                                    Command="{Binding OpenFolderCommand}"
                                />
                                <Button
                                    Classes="quiet"
                                    Content="Prefix folder"
                                    Command="{Binding OpenPrefixCommand}"
                                />
                                <Button
                                    Classes="quiet"
                                    Content="Prefix info"
                                    Command="{Binding PrefixInfoCommand}"
                                />
                                <Button
                                    Classes="quiet"
                                    Content="Site page"
                                    Command="{Binding OpenPageCommand}"
                                />
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Panel>
    </Panel>
</Window>
