<Window
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:SteamRip.App.ViewModels"
    xmlns:pages="using:SteamRip.App.Views.Pages"
    x:Class="SteamRip.App.Views.MainWindow"
    x:DataType="vm:MainViewModel"
    Title="SteamRIP Desktop"
    Width="1040"
    Height="700"
    MinWidth="820"
    MinHeight="520"
    Icon="avares://steamrip-desktop/Assets/app.png"
>
    <Window.DataTemplates>
        <!-- ============ LAUNCH TWEAKS (shared by Settings defaults and the per-game flyout) ============ -->
        <DataTemplate DataType="vm:LaunchOptionsEditor">
            <pages:LaunchOptionsEditorView />
        </DataTemplate>

        <!-- ============ LIBRARY ============ -->
        <DataTemplate DataType="vm:LibraryViewModel">
            <pages:LibraryView />
        </DataTemplate>

        <!-- ============ BROWSE ============ -->
        <DataTemplate DataType="vm:BrowseViewModel">
            <pages:BrowseView />
        </DataTemplate>

        <!-- ============ QUEUE ============ -->
        <DataTemplate DataType="vm:QueueViewModel">
            <pages:QueueView />
        </DataTemplate>

        <!-- ============ ACTIVITY ============ -->
        <DataTemplate DataType="vm:ActivityViewModel">
            <pages:ActivityView />
        </DataTemplate>

        <!-- ============ SETTINGS ============ -->
        <DataTemplate DataType="vm:SettingsViewModel">
            <pages:SettingsView />
        </DataTemplate>
    </Window.DataTemplates>

    <Panel>
        <Grid x:Name="Shell" ColumnDefinitions="216,*">
            <!-- Rail: where you are, what the machine is doing, and the one manual control. -->
            <Border
                x:Name="Rail"
                Background="{StaticResource Panel}"
                BorderBrush="{StaticResource Line}"
                BorderThickness="0,0,1,0"
            >
                <DockPanel Margin="14,18,14,14">
                    <StackPanel DockPanel.Dock="Top" Margin="6,0,0,24" Spacing="1">
                        <StackPanel Orientation="Horizontal" Spacing="9">
                            <Image
                                Source="avares://steamrip-desktop/Assets/app.png"
                                Width="20"
                                Height="20"
                            />
                            <TextBlock
                                Classes="nav-label"
                                Text="SteamRIP"
                                FontWeight="SemiBold"
                                FontSize="14.5"
                                VerticalAlignment="Center"
                            />
                        </StackPanel>
                        <TextBlock
                            Classes="mono muted nav-label"
                            FontSize="10.5"
                            Text="desktop client"
                            Margin="29,0,0,0"
                        />
                    </StackPanel>

                    <StackPanel Spacing="1">
                        <Button
                            Classes="nav"
                            Command="{Binding NavigateCommand}"
                            CommandParameter="Library"
                            ToolTip.Tip="Library"
                            Classes.active="{Binding Section, Converter={x:Static ObjectConverters.Equal}, ConverterParameter=Library}"
                        >
                            <DockPanel>
                                <TextBlock Classes="nav-glyph" Text="L" />
                                <TextBlock Classes="nav-label" Text="Library" />
                            </DockPanel>
                        </Button>
                        <Button
                            Classes="nav"
                            Command="{Binding NavigateCommand}"
                            CommandParameter="Browse"
                            ToolTip.Tip="Browse"
                            Classes.active="{Binding Section, Converter={x:Static ObjectConverters.Equal}, ConverterParameter=Browse}"
                        >
                            <DockPanel>
                                <TextBlock Classes="nav-glyph" Text="B" />
                                <TextBlock Classes="nav-label" Text="Browse" />
                            </DockPanel>
                        </Button>
                        <Button
                            Classes="nav"
                            Command="{Binding NavigateCommand}"
                            CommandParameter="Queue"
                            ToolTip.Tip="Queue"
                            Classes.active="{Binding Section, Converter={x:Static ObjectConverters.Equal}, ConverterParameter=Queue}"
                        >
                            <DockPanel>
                                <TextBlock Classes="nav-glyph" Text="Q" />
                                <Border
                                    DockPanel.Dock="Right"
                                    Classes="pill amber nav-count"
                                    IsVisible="{Binding QueueCount}"
                                >
                                    <TextBlock Text="{Binding QueueCount}" />
                                </Border>
                                <Border
                                    DockPanel.Dock="Right"
                                    Classes="pill nav-count"
                                    Margin="0,0,4,0"
                                    IsVisible="{Binding AttentionCount}"
                                >
                                    <TextBlock Classes="red" Text="{Binding AttentionCount}" />
                                </Border>
                                <TextBlock Classes="nav-label" Text="Queue" />
                            </DockPanel>
                        </Button>
                        <Button
                            Classes="nav"
                            Command="{Binding NavigateCommand}"
                            CommandParameter="Activity"
                            ToolTip.Tip="Activity"
                            Classes.active="{Binding Section, Converter={x:Static ObjectConverters.Equal}, ConverterParameter=Activity}"
                        >
                            <DockPanel>
                                <TextBlock Classes="nav-glyph" Text="A" />
                                <TextBlock Classes="nav-label" Text="Activity" />
                            </DockPanel>
                        </Button>
                        <Button
                            Classes="nav"
                            Command="{Binding NavigateCommand}"
                            CommandParameter="Settings"
                            ToolTip.Tip="Settings"
                            Classes.active="{Binding Section, Converter={x:Static ObjectConverters.Equal}, ConverterParameter=Settings}"
                        >
                            <DockPanel>
                                <TextBlock Classes="nav-glyph" Text="S" />
                                <TextBlock Classes="nav-label" Text="Settings" />
                            </DockPanel>
                        </Button>
                    </StackPanel>
                </DockPanel>
            </Border>

            <Grid Grid.Column="1" RowDefinitions="46,*">
                <Border
                    Background="{StaticResource Panel}"
                    BorderBrush="{StaticResource Line}"
                    BorderThickness="0,0,0,1"
                    Padding="28,0"
                >
                    <DockPanel VerticalAlignment="Center">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="10">
                            <Ellipse
                                x:Name="SyncDot"
                                Classes="dot"
                                Fill="{StaticResource Green}"
                                IsVisible="{Binding SolverHealthy}"
                            />
                            <Ellipse
                                x:Name="SyncDotBad"
                                Classes="dot"
                                Fill="{StaticResource Red}"
                                IsVisible="{Binding !SolverHealthy}"
                            />
                            <TextBlock
                                Classes="mono muted"
                                FontSize="10.5"
                                Text="{Binding SyncLine}"
                                ToolTip.Tip="{Binding SolverLine}"
                                VerticalAlignment="Center"
                            />
                            <Button
                                Classes="link"
                                Content="sync"
                                Command="{Binding SyncNowCommand}"
                                IsEnabled="{Binding !Syncing}"
                                FontSize="11"
                            />
                        </StackPanel>
                        <TextBlock
                            Classes="mono"
                            FontSize="10.5"
                            Text="steamrip desktop"
                            Foreground="{StaticResource Muted}"
                        />
                        <TextBlock
                            Classes="mono"
                            FontSize="10.5"
                            Text=" / "
                            Foreground="{StaticResource Line}"
                        />
                        <TextBlock
                            Classes="mono"
                            FontSize="10.5"
                            Text="{Binding Section}"
                            Foreground="{StaticResource Amber}"
                        />
                    </DockPanel>
                </Border>
                <ContentControl
                    x:Name="Page"
                    Grid.Row="1"
                    Content="{Binding Current}"
                    HorizontalAlignment="Stretch"
                />
            </Grid>
        </Grid>

        <!-- Toast: one line, bottom left of the content column, gone on its own. -->
        <Border
            x:Name="Toast"
            Classes="toast"
            HorizontalAlignment="Right"
            VerticalAlignment="Bottom"
            Margin="0,0,24,22"
            IsVisible="{Binding ToastVisible}"
        >
            <TextBlock Text="{Binding Toast}" FontSize="12.5" />
        </Border>

        <!-- Launch options: a sheet over the window, sectioned like Settings. -->
        <Panel IsVisible="{Binding IsEditing}">
            <Button
                Classes="backdrop"
                Command="{Binding CloseEditorCommand}"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
            />
            <Border x:Name="Sheet" Classes="sheet" HorizontalAlignment="Right" Width="560">
                <DockPanel>
                    <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="26,22,22,14">
                        <StackPanel Spacing="2">
                            <TextBlock Classes="mono muted" FontSize="10.5" Text="launch options" />
                            <TextBlock
                                Classes="h1"
                                Text="{Binding Editing.Name, FallbackValue=''}"
                                TextTrimming="CharacterEllipsis"
                            />
                        </StackPanel>
                        <Button
                            Grid.Column="1"
                            Classes="quiet"
                            Content="Close"
                            Command="{Binding CloseEditorCommand}"
                            VerticalAlignment="Top"
                        />
                    </Grid>
                    <ScrollViewer>
                        <StackPanel Margin="26,0,26,26" DataContext="{Binding Editing}">
                            <Border Classes="section" BorderThickness="0" Padding="0,0,0,16">
                                <StackPanel Spacing="8">
                                    <TextBlock Classes="h2" Text="Install folder" />
                                    <TextBox
                                        Text="{Binding CustomInstallPath}"
                                        PlaceholderText="{Binding DefaultInstallPath}"
                                        FontFamily="{StaticResource Mono}"
                                        FontSize="12"
                                    />
                                    <TextBlock
                                        Classes="meta"
                                        TextWrapping="Wrap"
                                        Text="Leave empty to use the library folder from Settings; an absolute path installs this game somewhere else."
                                    />
                                </StackPanel>
                            </Border>

                            <Border Classes="section">
                                <StackPanel Spacing="8">
                                    <TextBlock Classes="h2" Text="Executable and Proton" />
                                    <TextBlock Classes="label" Text="Executable" />
                                    <ComboBox
                                        ItemsSource="{Binding Exes}"
                                        SelectedItem="{Binding SelectedExe}"
                                        HorizontalAlignment="Stretch"
                                        FontFamily="{StaticResource Mono}"
                                        FontSize="12"
                                    />
                                    <TextBlock
                                        Classes="label"
                                        Text="Proton build"
                                        Margin="0,6,0,0"
                                    />
                                    <ComboBox
                                        ItemsSource="{Binding Protons}"
                                        SelectedItem="{Binding SelectedProton}"
                                        HorizontalAlignment="Stretch"
                                    />
                                    <TextBlock
                                        Classes="label"
                                        Text="Extra arguments"
                                        Margin="0,6,0,0"
                                    />
                                    <TextBox
                                        Text="{Binding LaunchArgs}"
                                        PlaceholderText="-windowed -nosplash"
                                        FontFamily="{StaticResource Mono}"
                                        FontSize="12"
                                    />
                                </StackPanel>
                            </Border>

                            <Border Classes="section">
                                <StackPanel Spacing="10">
                                    <StackPanel Spacing="2">
                                        <TextBlock Classes="h2" Text="Tweaks" />
                                        <TextBlock
                                            Classes="meta"
                                            TextWrapping="Wrap"
                                            Text="Starts from the Settings defaults; only what you change here is stored for this game."
                                        />
                                    </StackPanel>
                                    <ContentControl Content="{Binding Launch}" />
                                </StackPanel>
                            </Border>

                            <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,18,0,0">
                                <Button
                                    Classes="quiet"
                                    Content="Game folder"
                                    Command="{Binding OpenFolderCommand}"
                                />
                                <Button
                                    Classes="quiet"
                                    Content="Prefix folder"
                                    Command="{Binding OpenPrefixCommand}"
                                />
                                <Button
                                    Classes="quiet"
                                    Content="Prefix info"
                                    Command="{Binding PrefixInfoCommand}"
                                />
                                <Button
                                    Classes="quiet"
                                    Content="Site page"
                                    Command="{Binding OpenPageCommand}"
                                />
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Panel>
    </Panel>
</Window>
