<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:SteamRip.App.ViewModels"
    x:Class="SteamRip.App.Views.Pages.QueueView"
    x:DataType="vm:QueueViewModel"
>
    <UserControl.Styles>
        <!-- The running job is the only thing on this page that moves: a gradient bar with a light
             sweeping through it, and a halo behind it that breathes. Everything else is still. -->
        <Style Selector="Border.job">
            <Setter Property="BorderBrush" Value="{StaticResource Line}" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="Padding" Value="16,14" />
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.14" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Border.job:pointerover">
            <Setter Property="Background" Value="#1F1730" />
        </Style>
        <Style Selector="Border.charge">
            <Setter Property="Height" Value="4" />
            <Setter Property="CornerRadius" Value="2" />
            <Setter Property="Background" Value="{StaticResource Raised}" />
        </Style>
        <Style Selector="Border.chargeFill">
            <Setter Property="Height" Value="4" />
            <Setter Property="CornerRadius" Value="2" />
            <Setter Property="Background" Value="{StaticResource Signal}" />
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.6" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Border.chargeGlow">
            <Setter Property="Height" Value="10" />
            <Setter Property="Margin" Value="0,-3,0,-3" />
            <Setter Property="CornerRadius" Value="5" />
            <Setter Property="Background">
                <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,0%">
                    <GradientStop Offset="0" Color="#008438FF" />
                    <GradientStop Offset="0.5" Color="#558438FF" />
                    <GradientStop Offset="1" Color="#00FF007A" />
                </LinearGradientBrush>
            </Setter>
        </Style>
    </UserControl.Styles>

    <DockPanel Margin="28,24,28,20">
        <Grid DockPanel.Dock="Top" Margin="0,0,0,18" ColumnDefinitions="*,Auto">
            <StackPanel Spacing="3">
                <TextBlock Classes="h1" Text="Queue" />
                <Border
                    x:Name="Rule"
                    Width="52"
                    Height="2"
                    CornerRadius="1"
                    Background="{StaticResource Signal}"
                    HorizontalAlignment="Left"
                    Margin="0,2,0,0"
                />
                <TextBlock
                    Classes="meta"
                    Text="One job at a time. Updates queue themselves; installs start when you press Install."
                />
            </StackPanel>
            <StackPanel
                Grid.Column="1"
                Orientation="Horizontal"
                Spacing="10"
                VerticalAlignment="Center"
            >
                <ToggleSwitch
                    IsChecked="{Binding Paused}"
                    OnContent="Auto-updates paused"
                    OffContent="Auto-updates on"
                />
                <Button
                    Classes="quiet"
                    Content="Clear finished"
                    Command="{Binding ClearFinishedCommand}"
                />
            </StackPanel>
        </Grid>

        <StackPanel
            DockPanel.Dock="Top"
            Spacing="10"
            Margin="0,6,0,0"
            IsVisible="{Binding IsEmpty}"
        >
            <TextBlock Classes="h1" Text="Nothing queued." />
            <TextBlock
                Classes="meta"
                TextWrapping="Wrap"
                MaxWidth="520"
                HorizontalAlignment="Left"
                Text="Updates land here on their own when the catalog changes. Start something from Browse and it appears here while it downloads."
            />
        </StackPanel>

        <ScrollViewer HorizontalScrollBarVisibility="Disabled">
            <ItemsControl ItemsSource="{Binding Items}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="vm:JobItem">
                        <Border Classes="job">
                            <StackPanel>
                                <Grid ColumnDefinitions="*,Auto">
                                    <StackPanel Spacing="4">
                                        <StackPanel Orientation="Horizontal" Spacing="10">
                                            <TextBlock
                                                Text="{Binding Name}"
                                                FontWeight="SemiBold"
                                                FontSize="16"
                                                VerticalAlignment="Center"
                                            />
                                            <Border Classes="pill">
                                                <TextBlock Text="{Binding Kind}" />
                                            </Border>
                                            <TextBlock
                                                Classes="mono muted"
                                                FontSize="11"
                                                Text="{Binding Version}"
                                                VerticalAlignment="Center"
                                            />
                                        </StackPanel>
                                        <TextBlock
                                            Text="{Binding Status}"
                                            TextWrapping="Wrap"
                                            Classes.muted="{Binding Active}"
                                            Classes.red="{Binding NeedsAttention}"
                                            Classes.green="{Binding Done}"
                                            FontSize="12.5"
                                        />
                                    </StackPanel>
                                    <StackPanel
                                        Grid.Column="1"
                                        Orientation="Horizontal"
                                        Spacing="4"
                                        VerticalAlignment="Center"
                                    >
                                        <Button
                                            Classes="action"
                                            Content="Solve in browser"
                                            Command="{Binding SolveInBrowserCommand}"
                                            IsVisible="{Binding NeedsAttention}"
                                            IsEnabled="{Binding CanSolveInBrowser}"
                                            ToolTip.Tip="Opens a visible Chromium on the FileDitch mirror so you can pass its check; the download then continues here."
                                        />
                                        <Button
                                            Classes="quiet"
                                            Content="Retry"
                                            Command="{Binding RetryCommand}"
                                            IsVisible="{Binding Failed}"
                                        />
                                        <Button
                                            Classes="quiet"
                                            Content="Retry"
                                            Command="{Binding RetryCommand}"
                                            IsVisible="{Binding NeedsAttention}"
                                        />
                                        <Button
                                            Classes="danger"
                                            Content="Cancel"
                                            Command="{Binding CancelCommand}"
                                            IsVisible="{Binding Active}"
                                        />
                                    </StackPanel>
                                </Grid>

                                <!-- the charge bar: gradient fill, a soft halo, and the indeterminate
                                     state the downloader already reports -->
                                <Panel Margin="0,12,0,0" IsVisible="{Binding Active}">
                                    <Border Classes="chargeGlow" Opacity="0.45" />
                                    <ProgressBar
                                        Value="{Binding Fraction}"
                                        Maximum="1"
                                        IsIndeterminate="{Binding Indeterminate}"
                                        Height="4"
                                        Background="#2A1F3D"
                                        Foreground="{StaticResource Signal}"
                                    />
                                </Panel>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</UserControl>
