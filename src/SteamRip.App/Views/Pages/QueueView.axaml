<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:SteamRip.App.ViewModels"
    x:Class="SteamRip.App.Views.Pages.QueueView"
    x:DataType="vm:QueueViewModel"
>
    <DockPanel Margin="28,24,28,20">
        <Grid DockPanel.Dock="Top" Margin="0,0,0,20" ColumnDefinitions="*,Auto">
            <StackPanel Spacing="3">
                <TextBlock Classes="h1" Text="Queue" />
                <TextBlock
                    Classes="meta"
                    Text="One job at a time. Updates queue themselves; installs start when you press Install."
                />
            </StackPanel>
            <StackPanel
                Grid.Column="1"
                Orientation="Horizontal"
                Spacing="10"
                VerticalAlignment="Center"
            >
                <ToggleSwitch
                    IsChecked="{Binding Paused}"
                    OnContent="Auto-updates paused"
                    OffContent="Auto-updates on"
                />
                <Button
                    Classes="quiet"
                    Content="Clear finished"
                    Command="{Binding ClearFinishedCommand}"
                />
            </StackPanel>
        </Grid>

        <StackPanel
            DockPanel.Dock="Top"
            Spacing="10"
            Margin="0,4,0,0"
            IsVisible="{Binding IsEmpty}"
        >
            <TextBlock Classes="h2" Text="Nothing queued." />
            <TextBlock
                Classes="meta"
                TextWrapping="Wrap"
                MaxWidth="520"
                HorizontalAlignment="Left"
                Text="Updates land here on their own when the catalog changes. Start something from Browse and it appears here while it downloads."
            />
        </StackPanel>

        <ScrollViewer>
            <ItemsControl ItemsSource="{Binding Items}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="vm:JobItem">
                        <Border Classes="row" Padding="16,12,16,10">
                            <StackPanel>
                                <Grid ColumnDefinitions="*,Auto">
                                    <StackPanel Spacing="4">
                                        <StackPanel Orientation="Horizontal" Spacing="10">
                                            <TextBlock
                                                Text="{Binding Name}"
                                                FontWeight="SemiBold"
                                                FontSize="14.5"
                                                VerticalAlignment="Center"
                                            />
                                            <Border Classes="pill">
                                                <TextBlock Text="{Binding Kind}" />
                                            </Border>
                                            <TextBlock
                                                Classes="mono muted"
                                                FontSize="11"
                                                Text="{Binding Version}"
                                                VerticalAlignment="Center"
                                            />
                                        </StackPanel>
                                        <TextBlock
                                            Text="{Binding Status}"
                                            TextWrapping="Wrap"
                                            Classes.muted="{Binding Active}"
                                            Classes.red="{Binding NeedsAttention}"
                                            Classes.green="{Binding Done}"
                                        />
                                    </StackPanel>
                                    <StackPanel
                                        Grid.Column="1"
                                        Orientation="Horizontal"
                                        Spacing="4"
                                        VerticalAlignment="Center"
                                    >
                                        <Button
                                            Classes="action"
                                            Content="Solve in browser"
                                            Command="{Binding SolveInBrowserCommand}"
                                            IsVisible="{Binding NeedsAttention}"
                                            IsEnabled="{Binding CanSolveInBrowser}"
                                            ToolTip.Tip="Opens a visible Chromium on the FileDitch mirror so you can pass its check; the download then continues here."
                                        />
                                        <Button
                                            Classes="quiet"
                                            Content="Retry"
                                            Command="{Binding RetryCommand}"
                                            IsVisible="{Binding Failed}"
                                        />
                                        <Button
                                            Classes="quiet"
                                            Content="Retry"
                                            Command="{Binding RetryCommand}"
                                            IsVisible="{Binding NeedsAttention}"
                                        />
                                        <Button
                                            Classes="danger"
                                            Content="Cancel"
                                            Command="{Binding CancelCommand}"
                                            IsVisible="{Binding Active}"
                                        />
                                    </StackPanel>
                                </Grid>
                                <ProgressBar
                                    Margin="0,10,0,0"
                                    Value="{Binding Fraction}"
                                    Maximum="1"
                                    IsIndeterminate="{Binding Indeterminate}"
                                    IsVisible="{Binding Active}"
                                />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</UserControl>
