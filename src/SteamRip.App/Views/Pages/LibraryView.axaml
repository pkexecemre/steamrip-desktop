<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:SteamRip.App.ViewModels"
    x:Class="SteamRip.App.Views.Pages.LibraryView"
    x:DataType="vm:LibraryViewModel"
>
    <UserControl.Styles>
        <!--
            The shelf. Each game is a wide row: hairline separated, never a card. Hover is the only
            state that moves, so nothing animates when the page first lays out.
            The cover sits on a violet halo that is transparent at rest and warms up on hover; the
            cover itself lifts 4% and its rim goes from a cool hairline to violet.
        -->
        <Style Selector="Border.shelfHalo">
            <Setter Property="Background" Value="#008438FF" />
            <Setter Property="CornerRadius" Value="7" />
            <Setter Property="Margin" Value="-5" />
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.16" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="ListBoxItem:pointerover Border.shelfHalo">
            <Setter Property="Background" Value="#428438FF" />
        </Style>
        <Style Selector="Border.shelfCover">
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="#26FFFFFF" />
            <Setter Property="BoxShadow" Value="0 8 20 0 #77000000" />
            <Setter Property="RenderTransform" Value="scale(1)" />
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.16" />
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.16" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="ListBoxItem:pointerover Border.shelfCover">
            <Setter Property="BorderBrush" Value="#80A855F7" />
            <Setter Property="BoxShadow" Value="0 12 30 0 #668438FF" />
            <Setter Property="RenderTransform" Value="scale(1.04)" />
        </Style>
        <!-- Where Play would be, a game that is running says so, and the dot breathes. -->
        <Style Selector="Border.runPill">
            <Setter Property="Background" Value="#145FC08C" />
            <Setter Property="BorderBrush" Value="#665FC08C" />
            <Setter Property="MinWidth" Value="78" />
            <Setter Property="Padding" Value="9,5" />
            <Setter Property="CornerRadius" Value="3" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="Ellipse.runDot">
            <Setter Property="Opacity" Value="1" />
            <Style.Animations>
                <Animation Duration="0:0:1.7" IterationCount="INFINITE">
                    <KeyFrame Cue="0%">
                        <Setter Property="Opacity" Value="1" />
                    </KeyFrame>
                    <KeyFrame Cue="50%">
                        <Setter Property="Opacity" Value="0.3" />
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="Opacity" Value="1" />
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
    </UserControl.Styles>

    <DockPanel Margin="28,24,28,18">
        <Panel
            DockPanel.Dock="Top"
            Height="128"
            Margin="-28,-24,-28,6"
            ClipToBounds="True"
            IsVisible="{Binding !IsEmpty}"
        >
            <Border>
                <Border.Background>
                    <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                        <GradientStop Offset="0" Color="#CC8438FF" />
                        <GradientStop Offset="0.55" Color="#66FF007A" />
                        <GradientStop Offset="1" Color="#33120E1B" />
                    </LinearGradientBrush>
                </Border.Background>
            </Border>
            <Border>
                <Border.Background>
                    <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                        <GradientStop Offset="0" Color="#99120E1B" />
                        <GradientStop Offset="0.55" Color="#CC120E1B" />
                        <GradientStop Offset="1" Color="#FF120E1B" />
                    </LinearGradientBrush>
                </Border.Background>
            </Border>
        </Panel>

        <StackPanel DockPanel.Dock="Top" Spacing="4" Margin="0,0,0,14">
            <StackPanel Orientation="Horizontal" Spacing="10">
                <TextBlock Classes="h1" Text="Library" VerticalAlignment="Center" />
                <Border
                    x:Name="Rule"
                    Width="52"
                    Height="2"
                    CornerRadius="1"
                    Background="{StaticResource Signal}"
                    HorizontalAlignment="Left"
                    Margin="0,2,0,0"
                />
                <Border
                    Classes="pill amber"
                    VerticalAlignment="Center"
                    IsVisible="{Binding UpdatesAvailable}"
                >
                    <TextBlock Text="{Binding UpdatesLabel}" />
                </Border>
            </StackPanel>
            <TextBlock Classes="meta" Text="{Binding Summary}" IsVisible="{Binding !IsEmpty}" />
            <Border Height="1" Background="{StaticResource Line}" Margin="0,10,0,0" />
        </StackPanel>

        <Border DockPanel.Dock="Top" IsVisible="{Binding IsEmpty}" Margin="0,42,0,0">
            <StackPanel Spacing="14" MaxWidth="560" HorizontalAlignment="Left">
                <Border
                    Width="56"
                    Height="2"
                    CornerRadius="1"
                    HorizontalAlignment="Left"
                    Background="{StaticResource Signal}"
                />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock
                        FontSize="32"
                        FontWeight="SemiBold"
                        LetterSpacing="-0.8"
                        Text="The shelf is"
                    />
                    <TextBlock
                        FontSize="32"
                        FontWeight="SemiBold"
                        LetterSpacing="-0.8"
                        Text="empty."
                        Foreground="{StaticResource Signal}"
                    />
                </StackPanel>
                <TextBlock
                    Classes="muted"
                    FontSize="13.5"
                    LineHeight="21"
                    TextWrapping="Wrap"
                    Text="Browse the catalog and pick something to play — it downloads, verifies, extracts into your library and gets its own Proton prefix the first time you press play."
                />
                <Button
                    Classes="primary"
                    Content="Browse the catalog"
                    Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).NavigateCommand}"
                    CommandParameter="Browse"
                    HorizontalAlignment="Left"
                    Padding="18,9"
                    FontSize="13"
                    Margin="0,4,0,0"
                />
            </StackPanel>
        </Border>

        <Border
            DockPanel.Dock="Top"
            BorderBrush="{StaticResource Red}"
            BorderThickness="2,0,0,0"
            Padding="11,2"
            Margin="0,0,0,12"
            IsVisible="{Binding LastError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
        >
            <TextBlock Classes="red" TextWrapping="Wrap" Text="{Binding LastError}" />
        </Border>

        <ListBox ItemsSource="{Binding Items}" Classes="plain" Margin="0,2,0,0">
            <ListBox.ItemTemplate>
                <DataTemplate DataType="vm:LibraryItem">
                    <Border Classes="row">
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="18">
                            <Panel
                                Grid.Column="0"
                                Width="72"
                                Height="100"
                                VerticalAlignment="Center"
                            >
                                <Border Classes="shelfHalo" />
                                <Border Classes="cover shelfCover" Width="72" Height="100">
                                    <Panel>
                                        <TextBlock
                                            Classes="coverInitial"
                                            Text="{Binding Initial}"
                                            IsVisible="{Binding Cover, Converter={x:Static ObjectConverters.IsNull}}"
                                        />
                                        <Image Source="{Binding Cover}" Stretch="UniformToFill" />
                                    </Panel>
                                </Border>
                            </Panel>

                            <StackPanel
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                Spacing="5"
                                Margin="2,0,0,0"
                            >
                                <TextBlock
                                    Text="{Binding Name}"
                                    FontSize="16"
                                    FontWeight="SemiBold"
                                    LetterSpacing="-0.2"
                                    TextTrimming="CharacterEllipsis"
                                />
                                <StackPanel Orientation="Horizontal" Spacing="11">
                                    <TextBlock
                                        Classes="mono muted"
                                        FontSize="11.5"
                                        Text="{Binding InstalledVersion}"
                                    />
                                    <TextBlock
                                        Classes="mono muted"
                                        FontSize="11.5"
                                        Text="→"
                                        IsVisible="{Binding HasUpdate}"
                                    />
                                    <TextBlock
                                        Classes="mono amber"
                                        FontSize="11.5"
                                        Text="{Binding SiteVersion}"
                                        IsVisible="{Binding HasUpdate}"
                                    />
                                    <TextBlock Classes="meta" Text="{Binding SizeText}" />
                                    <TextBlock Classes="meta" Text="{Binding Playtime}" />
                                </StackPanel>
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                    <TextBlock
                                        Classes="meta"
                                        Text="{Binding StatusLine}"
                                        TextTrimming="CharacterEllipsis"
                                    />
                                    <TextBlock
                                        Grid.Column="1"
                                        Classes="mono muted"
                                        FontSize="10.5"
                                        Text="{Binding ExeLine}"
                                        TextTrimming="CharacterEllipsis"
                                    />
                                </Grid>
                                <ProgressBar
                                    Height="2"
                                    Margin="0,4,0,0"
                                    Minimum="0"
                                    Maximum="1"
                                    Value="{Binding JobFraction}"
                                    IsIndeterminate="{Binding JobIndeterminate}"
                                    IsVisible="{Binding IsBusy}"
                                />
                            </StackPanel>

                            <StackPanel
                                Grid.Column="2"
                                Orientation="Horizontal"
                                Spacing="6"
                                VerticalAlignment="Center"
                            >
                                <Button
                                    Classes="primary"
                                    Content="Play"
                                    Command="{Binding PlayCommand}"
                                    IsVisible="{Binding !IsRunning}"
                                    IsEnabled="{Binding CanPlay}"
                                    MinWidth="78"
                                />
                                <Border Classes="pill runPill" IsVisible="{Binding IsRunning}">
                                    <StackPanel
                                        Orientation="Horizontal"
                                        Spacing="6"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                    >
                                        <Ellipse
                                            Classes="runDot"
                                            Width="5"
                                            Height="5"
                                            Fill="{StaticResource Green}"
                                            VerticalAlignment="Center"
                                        />
                                        <TextBlock
                                            Text="running"
                                            FontSize="11"
                                            FontWeight="Medium"
                                            Foreground="{StaticResource Green}"
                                        />
                                    </StackPanel>
                                </Border>
                                <Button
                                    Classes="danger"
                                    Content="Stop"
                                    Command="{Binding StopCommand}"
                                    IsVisible="{Binding IsRunning}"
                                    MinWidth="78"
                                />
                                <!-- While a job runs for this game, the row can stop it: the queue is one
                                     page away and this is where the eye already is. -->
                                <Button
                                    Classes="danger"
                                    Content="Stop"
                                    Command="{Binding CancelCommand}"
                                    IsVisible="{Binding IsBusy}"
                                    MinWidth="78"
                                />
                                <Button
                                    Classes="action"
                                    Content="Update"
                                    Command="{Binding UpdateNowCommand}"
                                    IsVisible="{Binding HasUpdate}"
                                    IsEnabled="{Binding IsIdle}"
                                />
                                <Button
                                    Classes="link"
                                    Content="Options"
                                    Command="{Binding OptionsCommand}"
                                />
                                <Button
                                    Classes="link"
                                    Content="···"
                                    FontSize="13"
                                    Padding="8,4"
                                    ToolTip.Tip="Shortcuts, wrapper tools, prefix and uninstall"
                                >
                                    <Button.Flyout>
                                        <MenuFlyout>
                                            <MenuItem
                                                Header="{Binding AutoLabel}"
                                                Command="{Binding ToggleAutoCommand}"
                                            />
                                            <Separator />
                                            <MenuItem
                                                Header="{Binding MenuShortcutLabel}"
                                                Command="{Binding ToggleMenuShortcutCommand}"
                                            />
                                            <MenuItem
                                                Header="{Binding DesktopShortcutLabel}"
                                                Command="{Binding ToggleDesktopShortcutCommand}"
                                            />
                                            <Separator IsVisible="{Binding IsLinux}" />
                                            <MenuItem
                                                Header="Winetricks"
                                                Command="{Binding WinetricksCommand}"
                                                IsVisible="{Binding IsLinux}"
                                                ToolTip.Tip="Open winetricks against this game's Proton prefix (same Proton wine as Play)"
                                            />
                                            <MenuItem
                                                Header="Run exe…"
                                                Command="{Binding RunExeCommand}"
                                                IsVisible="{Binding IsLinux}"
                                                ToolTip.Tip="Run an .exe or .msi (for example from _CommonRedist) inside this game's prefix"
                                            />
                                            <MenuItem
                                                Header="Prefix info"
                                                Command="{Binding PrefixInfoCommand}"
                                                IsVisible="{Binding IsLinux}"
                                                ToolTip.Tip="Size, Proton build and launch count of this game's Wine prefix (also in the log)"
                                            />
                                            <MenuItem
                                                Header="Reset prefix (moves it aside)"
                                                Command="{Binding ResetPrefixCommand}"
                                                IsVisible="{Binding IsLinux}"
                                                ToolTip.Tip="Move the prefix to a .bak folder and let the next launch build a clean one. Nothing is deleted."
                                            />
                                            <Separator />
                                            <MenuItem
                                                Header="Forget (keep files)"
                                                Command="{Binding ForgetCommand}"
                                            />
                                            <MenuItem
                                                Classes="danger"
                                                Header="Uninstall and delete files"
                                                Command="{Binding DeleteCommand}"
                                            />
                                        </MenuFlyout>
                                    </Button.Flyout>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </DockPanel>
</UserControl>
