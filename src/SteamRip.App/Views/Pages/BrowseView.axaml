<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:SteamRip.App.ViewModels"
    x:Class="SteamRip.App.Views.Pages.BrowseView"
    x:DataType="vm:BrowseViewModel"
>
    <UserControl.Styles>
        <!-- The card is the button: a cover, the name on a scrim, and a pill that always says what a
             click will do. Hover answers the pointer, because a catalogue that looks dead reads dead. -->
        <Style Selector="Button.bare">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
        </Style>
        <Style Selector="Button.bare /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style Selector="Button.bare:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>

        <Style Selector="Border.tile">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="RenderTransform" Value="scale(1)" />
            <Setter Property="Transitions">
                <Transitions>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.16" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.bare:pointerover Border.tile">
            <Setter Property="RenderTransform" Value="scale(1.035)" />
        </Style>
        <Style Selector="Border.tileCover">
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="ClipToBounds" Value="True" />
            <Setter Property="Background" Value="{StaticResource Raised}" />
            <Setter Property="BoxShadow" Value="0 6 18 0 #66000000" />
        </Style>
        <Style Selector="Button.bare:pointerover Border.tileCover">
            <Setter Property="BoxShadow" Value="0 10 30 0 #998438FF" />
        </Style>
        <Style Selector="Border.tileScrim">
            <Setter Property="CornerRadius" Value="0,0,6,6" />
            <Setter Property="Background">
                <LinearGradientBrush StartPoint="50%,0%" EndPoint="50%,100%">
                    <GradientStop Offset="0" Color="#00000000" />
                    <GradientStop Offset="0.55" Color="#B3090512" />
                    <GradientStop Offset="1" Color="#F2090512" />
                </LinearGradientBrush>
            </Setter>
        </Style>

        <!-- The pill always shows the state; only its colour changes with it. -->
        <Style Selector="Border.actionPill">
            <Setter Property="CornerRadius" Value="11" />
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="Margin" Value="8" />
            <Setter Property="Background" Value="{StaticResource Signal}" />
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.16" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.bare:pointerover Border.actionPill">
            <Setter Property="Background" Value="{StaticResource SignalDown}" />
        </Style>
        <Style Selector="Border.actionPill.quiet">
            <Setter Property="Background" Value="#CC120E1B" />
            <Setter Property="BorderBrush" Value="#40FFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <Style Selector="Border.sheen">
            <Setter Property="Width" Value="70" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="Opacity" Value="0" />
            <Setter Property="IsHitTestVisible" Value="False" />
            <Setter Property="Background">
                <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,0%">
                    <GradientStop Offset="0" Color="#00FFFFFF" />
                    <GradientStop Offset="0.5" Color="#73FFFFFF" />
                    <GradientStop Offset="1" Color="#00FFFFFF" />
                </LinearGradientBrush>
            </Setter>
        </Style>
        <Style Selector="Button.bare:pointerover Border.sheen">
            <Style.Animations>
                <Animation Duration="0:0:0.7" IterationCount="1">
                    <KeyFrame Cue="0%">
                        <Setter Property="Opacity" Value="0" />
                    </KeyFrame>
                    <KeyFrame Cue="45%">
                        <Setter Property="Opacity" Value="0.75" />
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="Opacity" Value="0" />
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
    </UserControl.Styles>

    <DockPanel Margin="28,24,28,20">
        <!-- The same wash the library opens with, so both pages feel like the same shop. -->
        <Panel DockPanel.Dock="Top" Height="96" Margin="-28,-24,-28,4" ClipToBounds="True">
            <Border>
                <Border.Background>
                    <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                        <GradientStop Offset="0" Color="#CC8438FF" />
                        <GradientStop Offset="0.55" Color="#66FF007A" />
                        <GradientStop Offset="1" Color="#33120E1B" />
                    </LinearGradientBrush>
                </Border.Background>
            </Border>
            <Border>
                <Border.Background>
                    <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                        <GradientStop Offset="0" Color="#00120E1B" />
                        <GradientStop Offset="1" Color="#FF120E1B" />
                    </LinearGradientBrush>
                </Border.Background>
            </Border>
        </Panel>

        <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,14">
            <StackPanel Spacing="3">
                <TextBlock Classes="h1" Text="Browse" />
                <Border
                    x:Name="Rule"
                    Width="52"
                    Height="2"
                    CornerRadius="1"
                    Background="{StaticResource Signal}"
                    HorizontalAlignment="Left"
                    Margin="0,2,0,0"
                />
                <TextBlock Classes="meta" Text="{Binding Summary}" TextWrapping="Wrap" />
            </StackPanel>
            <StackPanel
                Grid.Column="1"
                Orientation="Horizontal"
                Spacing="6"
                VerticalAlignment="Center"
            >
                <Button Classes="quiet" Content="Sync now" Command="{Binding SyncCommand}" />
                <Button
                    Classes="quiet"
                    Content="Full re-sync"
                    Command="{Binding FullSyncCommand}"
                    ToolTip.Tip="Re-fetch all ~5,000 posts (about 50 requests)"
                />
            </StackPanel>
        </Grid>

        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
            <StackPanel
                DockPanel.Dock="Right"
                Orientation="Horizontal"
                Spacing="6"
                Margin="8,0,0,0"
            >
                <ComboBox
                    ItemsSource="{Binding Genres}"
                    SelectedItem="{Binding Genre}"
                    DisplayMemberBinding="{Binding Name}"
                    MinWidth="170"
                    VerticalAlignment="Center"
                    ToolTip.Tip="Genre (the site's categories)"
                />
                <ComboBox
                    ItemsSource="{Binding Sorts}"
                    SelectedItem="{Binding Sort}"
                    DisplayMemberBinding="{Binding Label}"
                    MinWidth="170"
                    VerticalAlignment="Center"
                    ToolTip.Tip="Sort order"
                />
            </StackPanel>
            <TextBox
                Classes="search"
                PlaceholderText="Search 5,000 games…"
                Text="{Binding Query}"
                MaxWidth="420"
                HorizontalAlignment="Left"
            />
        </DockPanel>

        <StackPanel
            DockPanel.Dock="Top"
            Spacing="12"
            Margin="0,28,0,0"
            IsVisible="{Binding IsEmpty}"
        >
            <StackPanel Spacing="12" IsVisible="{Binding !HasCatalog}">
                <TextBlock Classes="h1" Text="No catalog yet." />
                <TextBlock
                    Classes="meta"
                    MaxWidth="520"
                    HorizontalAlignment="Left"
                    TextWrapping="Wrap"
                    Text="The first sync starts a few seconds after launch and takes a minute. If nothing appears, press Sync now."
                />
                <Button
                    Classes="primary"
                    Content="Sync now"
                    Command="{Binding SyncCommand}"
                    HorizontalAlignment="Left"
                />
            </StackPanel>
            <StackPanel Spacing="12" IsVisible="{Binding HasCatalog}">
                <TextBlock Classes="h1" Text="Nothing matches that." />
                <TextBlock
                    Classes="meta"
                    MaxWidth="520"
                    HorizontalAlignment="Left"
                    TextWrapping="Wrap"
                    Text="Clear the search or pick another genre. The catalog itself is still there."
                />
                <Button
                    Classes="quiet"
                    Content="Clear filters"
                    Command="{Binding ClearFiltersCommand}"
                    HorizontalAlignment="Left"
                />
            </StackPanel>
        </StackPanel>

        <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="Grid" ItemsSource="{Binding Items}" Margin="0,14,0,0">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel ItemWidth="176" ItemHeight="304" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="vm:BrowseItem">
                        <Border Classes="tile" Margin="0,0,8,10" Width="168">
                            <Grid RowDefinitions="224,Auto,Auto">
                                <!-- Clicking the artwork installs the game; the pill says so. -->
                                <Button
                                    Classes="bare"
                                    Command="{Binding ActivateCommand}"
                                    ToolTip.Tip="{Binding CardTip}"
                                    AutomationProperties.Name="{Binding Name}"
                                >
                                    <Border Classes="tileCover" Height="224">
                                        <Panel>
                                            <TextBlock
                                                Classes="coverInitial"
                                                FontSize="40"
                                                Text="{Binding Initial}"
                                                IsVisible="{Binding Cover, Converter={x:Static ObjectConverters.IsNull}}"
                                            />
                                            <Image
                                                Source="{Binding Cover}"
                                                Stretch="UniformToFill"
                                            />
                                            <Border Classes="sheen" />

                                            <Border
                                                Classes="tileScrim"
                                                VerticalAlignment="Bottom"
                                                Height="170"
                                            >
                                                <StackPanel
                                                    VerticalAlignment="Bottom"
                                                    Margin="10,0,76,10"
                                                    Spacing="1"
                                                >
                                                    <!-- the full title: "Trilogy" and "Enhanced" are the whole difference -->
                                                    <TextBlock
                                                        Text="{Binding Name}"
                                                        FontWeight="SemiBold"
                                                        FontSize="12.8"
                                                        LineHeight="14.5"
                                                        TextWrapping="Wrap"
                                                        MaxLines="4"
                                                    />
                                                    <TextBlock
                                                        Classes="mono"
                                                        FontSize="10.5"
                                                        Foreground="#C9BEE0"
                                                        Text="{Binding Version}"
                                                    />
                                                </StackPanel>
                                            </Border>

                                            <Border
                                                Classes="pill"
                                                HorizontalAlignment="Left"
                                                VerticalAlignment="Top"
                                                Margin="8"
                                                IsVisible="{Binding Installed}"
                                            >
                                                <TextBlock Classes="green" Text="in library" />
                                            </Border>

                                            <Border
                                                Classes="pill"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Top"
                                                Margin="8"
                                                IsVisible="{Binding Queued}"
                                            >
                                                <TextBlock
                                                    Text="in queue"
                                                    Foreground="{StaticResource VioletSoft}"
                                                />
                                            </Border>

                                            <!-- the one control: always there, never only on hover -->
                                            <Border
                                                Classes="actionPill"
                                                Classes.quiet="{Binding Queued}"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Bottom"
                                                Margin="10"
                                            >
                                                <TextBlock
                                                    Text="{Binding ActionLabel}"
                                                    FontSize="11.5"
                                                    FontWeight="SemiBold"
                                                />
                                            </Border>
                                        </Panel>
                                    </Border>
                                </Button>

                                <ProgressBar
                                    Grid.Row="1"
                                    Height="2"
                                    Margin="0,6,0,0"
                                    Minimum="0"
                                    Maximum="1"
                                    Value="{Binding JobFraction}"
                                    IsIndeterminate="{Binding JobIndeterminate}"
                                    IsVisible="{Binding Queued}"
                                />

                                <Grid Grid.Row="2" ColumnDefinitions="*,Auto" Margin="2,8,2,0">
                                    <StackPanel Spacing="2">
                                        <TextBlock
                                            Classes="mono"
                                            FontSize="10.5"
                                            Foreground="#B9ABD4"
                                            Text="{Binding Size}"
                                        />
                                        <TextBlock
                                            Classes="mono muted"
                                            FontSize="10"
                                            Text="{Binding Updated}"
                                            TextTrimming="CharacterEllipsis"
                                        />
                                    </StackPanel>
                                    <Button
                                        Grid.Column="1"
                                        Classes="link"
                                        Content="page"
                                        Command="{Binding OpenPageCommand}"
                                        FontSize="11"
                                        VerticalAlignment="Center"
                                    />
                                </Grid>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</UserControl>
