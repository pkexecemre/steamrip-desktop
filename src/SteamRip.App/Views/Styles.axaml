<Styles
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
>
    <!--
        SteamRIP Desktop. One type family for the interface (IBM Plex Sans) and its mono sibling for
        anything the machine produced: versions, paths, sizes, counts. One accent (amber) that only
        marks the current place, the primary action and progress. Rows are separated by hairlines,
        not wrapped in cards; nothing has a glow, a gradient or a shadow except the side sheet.
    -->
    <Style Selector="Window">
        <Setter Property="Background" Value="{StaticResource Ink}" />
        <Setter Property="Foreground" Value="{StaticResource Text}" />
        <Setter Property="FontFamily" Value="{StaticResource Sans}" />
        <Setter Property="FontSize" Value="13" />
    </Style>

    <Style Selector="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource Text}" />
    </Style>
    <Style Selector="TextBlock.muted">
        <Setter Property="Foreground" Value="{StaticResource Muted}" />
    </Style>
    <Style Selector="TextBlock.mono">
        <Setter Property="FontFamily" Value="{StaticResource Mono}" />
        <Setter Property="FontSize" Value="12" />
    </Style>
    <Style Selector="TextBlock.amber">
        <Setter Property="Foreground" Value="{StaticResource Amber}" />
    </Style>
    <Style Selector="TextBlock.green">
        <Setter Property="Foreground" Value="{StaticResource Green}" />
    </Style>
    <Style Selector="TextBlock.red">
        <Setter Property="Foreground" Value="{StaticResource Red}" />
    </Style>

    <!-- Type scale: 20 page, 15 row title, 13 body, 11.5 meta. -->
    <Style Selector="TextBlock.h1">
        <Setter Property="FontSize" Value="25" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="LetterSpacing" Value="-0.5" />
    </Style>
    <Style Selector="TextBlock.h2">
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="TextBlock.meta">
        <Setter Property="FontSize" Value="11.5" />
        <Setter Property="Foreground" Value="{StaticResource Muted}" />
    </Style>
    <Style Selector="TextBlock.label">
        <Setter Property="FontSize" Value="11.5" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource Muted}" />
        <Setter Property="Margin" Value="0,0,0,2" />
    </Style>
    <!-- Kept for the older blocks that still use it: a quiet section label, not tracked-out caps. -->
    <Style Selector="TextBlock.eyebrow">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="LetterSpacing" Value="0.4" />
        <Setter Property="Foreground" Value="{StaticResource Muted}" />
        <Setter Property="Margin" Value="0,0,0,4" />
    </Style>

    <!-- Keyboard focus: one amber hairline around whatever has it, only while tabbing. -->
    <Style Selector="Button">
        <Setter Property="FocusAdorner">
            <Template>
                <Border
                    BorderBrush="{StaticResource Amber}"
                    BorderThickness="1"
                    CornerRadius="3"
                    Margin="1"
                />
            </Template>
        </Setter>
    </Style>
    <Style Selector="TextBox">
        <Setter Property="FocusAdorner">
            <Template>
                <Border
                    BorderBrush="{StaticResource Amber}"
                    BorderThickness="1"
                    CornerRadius="3"
                    Margin="1"
                />
            </Template>
        </Setter>
    </Style>
    <Style Selector="ComboBox">
        <Setter Property="FocusAdorner">
            <Template>
                <Border
                    BorderBrush="{StaticResource Amber}"
                    BorderThickness="1"
                    CornerRadius="3"
                    Margin="1"
                />
            </Template>
        </Setter>
    </Style>
    <Style Selector="ToggleSwitch">
        <Setter Property="FocusAdorner">
            <Template>
                <Border BorderBrush="{StaticResource Amber}" BorderThickness="1" Margin="1" />
            </Template>
        </Setter>
    </Style>
    <Style Selector="ListBoxItem">
        <Setter Property="FocusAdorner">
            <Template>
                <Border BorderBrush="{StaticResource Amber}" BorderThickness="1" Margin="0" />
            </Template>
        </Setter>
    </Style>
    <!-- Nav rail: flat rows, a 2px amber spine on the current one. -->
    <!-- Compact rail (narrow window): icons only, labels gone, everything centred. -->
    <Style Selector="Border.compact TextBlock.nav-label">
        <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="Border.compact StackPanel.rail-status">
        <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="TextBlock.nav-glyph">
        <Setter Property="IsVisible" Value="False" />
        <Setter Property="FontFamily" Value="{StaticResource Mono}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Width" Value="16" />
        <Setter Property="Foreground" Value="{StaticResource Muted}" />
    </Style>
    <Style Selector="Border.compact TextBlock.nav-glyph">
        <Setter Property="IsVisible" Value="True" />
    </Style>
    <Style Selector="Border.compact Border.nav-count">
        <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="Border.compact Button.nav">
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="Padding" Value="0" />
    </Style>
    <Style Selector="Border.compact Button.nav TextBlock">
        <Setter Property="Margin" Value="0" />
    </Style>
    <Style Selector="Button.nav">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource Muted}" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="Padding" Value="12,10" />
        <Setter Property="CornerRadius" Value="3" />
        <Setter Property="BorderThickness" Value="3,0,0,0" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="FontSize" Value="13" />
    </Style>
    <Style Selector="Button.nav:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{StaticResource Raised}" />
        <Setter Property="Foreground" Value="{StaticResource Text}" />
    </Style>
    <Style Selector="Button.nav.active /template/ ContentPresenter">
        <Setter Property="Background" Value="{StaticResource Raised}" />
        <Setter Property="Foreground" Value="{StaticResource Text}" />
    </Style>
    <Style Selector="Button.nav.active">
        <Setter Property="BorderBrush" Value="{StaticResource Violet}" />
        <Setter Property="Foreground" Value="{StaticResource Text}" />
    </Style>
    <Style Selector="Button.nav.active TextBlock.nav-label">
        <Setter Property="Foreground" Value="{StaticResource Text}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Button.nav TextBlock">
        <Setter Property="Foreground" Value="{StaticResource Muted}" />
    </Style>
    <Style Selector="Button.nav:pointerover TextBlock, Button.nav.active TextBlock">
        <Setter Property="Foreground" Value="{StaticResource Text}" />
    </Style>

    <!-- Game rows: a hairline, a hover lift, no card. -->
    <Style Selector="ListBoxItem:pointerover Border.row">
        <Setter Property="Background" Value="#1F1730" />
    </Style>
    <Style Selector="Border.row">
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.12" />
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="Border.event">
        <Setter Property="BorderBrush" Value="{StaticResource Line}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Setter Property="Padding" Value="0,4" />
    </Style>
    <Style Selector="Border.row">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{StaticResource Line}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Setter Property="Padding" Value="14,12" />
    </Style>

    <Style Selector="Border.cover">
        <Setter Property="Background" Value="{StaticResource Raised}" />
        <Setter Property="CornerRadius" Value="3" />
        <Setter Property="ClipToBounds" Value="True" />
        <Setter Property="VerticalAlignment" Value="Top" />
        <Setter Property="BoxShadow" Value="0 0 0 1 #33FFFFFF" />
        <Setter Property="Transitions">
            <Transitions>
                <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.18" />
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="ListBoxItem:pointerover Border.cover">
        <Setter Property="RenderTransform" Value="scale(1.06)" />
    </Style>
    <Style Selector="TextBlock.coverInitial">
        <Setter Property="Foreground" Value="{StaticResource Muted}" />
        <Setter Property="FontSize" Value="24" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- Virtualized game lists: look like ItemsControl, only realize visible rows so covers fetch for what is on screen. -->
    <Style Selector="ListBox.plain">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
    </Style>
    <Style Selector="ListBox.plain ListBoxItem">
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="ListBox.plain ListBoxItem:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="ListBox.plain ListBoxItem:selected /template/ ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="ListBox.plain ListBoxItem:selected:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
    </Style>

    <Style Selector="Border.section">
        <Setter Property="BorderBrush" Value="{StaticResource Line}" />
        <Setter Property="BorderThickness" Value="0,1,0,0" />
        <Setter Property="Padding" Value="0,18,0,0" />
        <Setter Property="Margin" Value="0,4,0,0" />
    </Style>
    <Style Selector="Border.card">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{StaticResource Line}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Padding" Value="16,12" />
    </Style>
    <Style Selector="Border.pill">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{StaticResource Line}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="3" />
        <Setter Property="Padding" Value="6,1" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.pill TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Mono}" />
        <Setter Property="FontSize" Value="10.5" />
        <Setter Property="Foreground" Value="{StaticResource Muted}" />
    </Style>
    <Style Selector="Border.pill.amber">
        <Setter Property="Background" Value="{StaticResource Amber}" />
        <Setter Property="BorderBrush" Value="{StaticResource Amber}" />
    </Style>
    <Style Selector="Border.pill.amber TextBlock">
        <Setter Property="Foreground" Value="{StaticResource Ink}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <!-- Buttons: the primary is the only filled control on screen. -->
    <Style Selector="Button">
        <Setter Property="CornerRadius" Value="3" />
        <Setter Property="Padding" Value="12,6" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="FontWeight" Value="Medium" />
    </Style>
    <Style Selector="Button:focus-visible /template/ ContentPresenter">
        <Setter Property="BorderBrush" Value="{StaticResource Amber}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="Button.primary">
        <Setter Property="Background" Value="{StaticResource Signal}" />
        <Setter Property="Foreground" Value="#FFFFFF" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.15" />
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="Button.primary:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{StaticResource Signal}" />
        <Setter Property="Foreground" Value="#FFFFFF" />
    </Style>
    <Style Selector="Button.action">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource Amber}" />
        <Setter Property="BorderBrush" Value="{StaticResource Amber}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Button.action:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{StaticResource Amber}" />
        <Setter Property="Foreground" Value="{StaticResource Ink}" />
    </Style>
    <Style Selector="Button.quiet">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource Muted}" />
        <Setter Property="BorderBrush" Value="{StaticResource Line}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="Button.quiet:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{StaticResource Raised}" />
        <Setter Property="Foreground" Value="{StaticResource Text}" />
    </Style>
    <Style Selector="Button.link">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource Muted}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="2,0" />
    </Style>
    <Style Selector="Button.link:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource Amber}" />
    </Style>

    <!-- Side sheet overlay -->
    <Style Selector="Button.backdrop">
        <Setter Property="Background" Value="#B3080A0E" />
        <Setter Property="CornerRadius" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="Button.backdrop:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="#B3080A0E" />
    </Style>
    <Style Selector="Button.backdrop:pressed /template/ ContentPresenter">
        <Setter Property="Background" Value="#B3080A0E" />
    </Style>
    <Style Selector="Border.toast">
        <Setter Property="Background" Value="{StaticResource Raised}" />
        <Setter Property="BorderBrush" Value="{StaticResource Line}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Padding" Value="14,9" />
    </Style>
    <Style Selector="Border.sheet">
        <Setter Property="Background" Value="{StaticResource Panel}" />
        <Setter Property="BorderBrush" Value="{StaticResource Line}" />
        <Setter Property="BorderThickness" Value="1,0,0,0" />
        <Setter Property="BoxShadow" Value="-12 0 40 0 #99000000" />
    </Style>
    <Style Selector="Button.danger">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource Red}" />
        <Setter Property="BorderBrush" Value="{StaticResource Line}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>

    <Style Selector="ProgressBar">
        <Setter Property="Foreground" Value="{StaticResource Amber}" />
        <Setter Property="Background" Value="{StaticResource Raised}" />
        <Setter Property="MinHeight" Value="3" />
        <Setter Property="Height" Value="3" />
        <Setter Property="CornerRadius" Value="0" />
    </Style>

    <Style Selector="TextBox">
        <Setter Property="Background" Value="{StaticResource Panel}" />
        <Setter Property="BorderBrush" Value="{StaticResource Line}" />
        <Setter Property="CornerRadius" Value="3" />
        <Setter Property="MinHeight" Value="30" />
    </Style>
    <Style Selector="TextBox:focus /template/ Border#PART_BorderElement">
        <Setter Property="BorderBrush" Value="{StaticResource Amber}" />
    </Style>

    <!-- Menus: compact rows, square-ish hover, a hairline separator. -->
    <Style Selector="MenuFlyoutPresenter">
        <Setter Property="MinWidth" Value="220" />
        <Setter Property="CornerRadius" Value="4" />
    </Style>
    <Style Selector="MenuItem">
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="CornerRadius" Value="2" />
        <Setter Property="Margin" Value="2,1" />
        <Setter Property="MinHeight" Value="0" />
    </Style>
    <Style Selector="MenuItem.danger">
        <Setter Property="Foreground" Value="{StaticResource Red}" />
    </Style>
    <Style Selector="MenuFlyoutPresenter Separator">
        <Setter Property="Background" Value="{StaticResource Line}" />
        <Setter Property="Height" Value="1" />
        <Setter Property="Margin" Value="8,4" />
    </Style>
    <Style Selector="FlyoutPresenter">
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Padding" Value="14" />
    </Style>
    <Style Selector="ToggleSwitch">
        <Setter Property="Foreground" Value="{StaticResource Text}" />
    </Style>
    <Style Selector="Ellipse.dot">
        <Setter Property="Width" Value="6" />
        <Setter Property="Height" Value="6" />
        <Setter Property="Transitions">
            <Transitions>
                <DoubleTransition Property="Opacity" Duration="0:0:0.45" />
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="ComboBox">
        <Setter Property="CornerRadius" Value="3" />
        <Setter Property="MinHeight" Value="30" />
    </Style>
    <Style Selector="ScrollBar">
        <Setter Property="Background" Value="Transparent" />
    </Style>
</Styles>
